# Mutation cases: tests/test_filesystem_findings.bats against modules/filesystem.sh.
# mutate-suite: modules/filesystem.sh tests/test_filesystem_findings.bats
#
# Each case misreads a path a real host ships or an attacker can create: a
# symlinked drop-in, a whitelisted name one directory off, a second getcap
# clause, a name holding a newline or a backslash.

run_case "symlink/link-mode-audited" 1 \
    '    actual=$(stat -L -c "%a" "$file" 2>/dev/null)' \
    '    actual=$(stat -c "%a" "$file" 2>/dev/null)'

# Through the link's 777 the fix would chmod a stricter 400 target up to 440.
run_case "symlink/link-mode-fixed" 1 \
    '        actual=$(stat -L -c "%a" "$file" 2>/dev/null)' \
    '        actual=$(stat -c "%a" "$file" 2>/dev/null)'

run_case "glob/star-crosses-slash" 1 \
    '    [[ "$1" == $2 && ${#a} -eq ${#b} ]]' \
    '    [[ "$1" == $2 ]]'

run_case "caps/first-clause-only" 1 \
    '    read -ra clauses <<<"$1"' \
    '    clauses=("${1%% *}")'

run_case "caps/all-caps-subset" 1 \
    '        [[ -n "$names" && "$names" != "$clause" ]] || return 1' \
    '        [[ -n "$names" ]] || continue'

# snap-confine back to the one capability snapd held before 2.70.
run_case "caps/snap-confine-set-narrowed" 1 \
    '    "/usr/lib/snapd/snap-confine:cap_chown,cap_dac_override,cap_dac_read_search,cap_fowner,cap_setgid,cap_setuid,cap_sys_chroot,cap_sys_ptrace,cap_sys_admin,cap_sys_resource:snapd"' \
    '    "/usr/lib/snapd/snap-confine:cap_sys_admin"'

run_case "caps/package-check-dropped" 1 \
    '               && _fs_caps_package_ok "$file" "$wl_pkg"; then' \
    '               && true; then'

# A copy no package vouches for (swapped, or the manager cannot tell) let through.
run_case "caps/unverified-copy-passes" 1 \
    '    pkg=$(file_package_verified "$1") || return 1' \
    '    pkg=$(file_package_verified "$1") || return 0'

run_case "caps/any-package-vouches" 1 \
    '        [[ -n "$alt" && "$pkg" == $alt ]] && return 0' \
    '        [[ -n "$alt" ]] && return 0'

# Quoted, the pattern is literal and sssd-* matches no sssd subpackage.
run_case "caps/package-glob-literal" 1 \
    '        [[ -n "$alt" && "$pkg" == $alt ]] && return 0' \
    '        [[ -n "$alt" && "$pkg" == "$alt" ]] && return 0'

# Unsplit, "iputils-ping|iputils" names no package on any family.
run_case "caps/alternatives-unsplit" 1 \
    "    IFS='|' read -ra alts <<<\"\$2\"" \
    '    alts=("$2")'

run_case "caps/family-entries-dropped" 1 \
    '    mapfile -t -O "${#caps_whitelist[@]}" caps_whitelist < <(distro_caps_whitelist)' \
    '    :'

run_case "names/newline-raw" 1 \
    "    if [[ \"\$1\" == *[[:cntrl:]]* ]]; then printf '%q\\n' \"\$1\"; else printf '%s\\n' \"\$1\"; fi" \
    "    printf '%s\\n' \"\$1\""

run_case "names/echo-e-back" 1 \
    "        local items=\$(printf '%s\\n' \"\$ww_files\" \"\$ww_dirs\" | sed '/^\$/d' | head -5 | tr '\\n' ' ')" \
    "        local items=\$(echo -e \"\$ww_files\\n\$ww_dirs\" | head -5 | tr '\\n' ' ')"
