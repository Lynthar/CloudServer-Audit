# Mutation cases: tests/test_fix_ssh_dropin.bats against modules/ssh.sh.
# mutate-suite: modules/ssh.sh tests/test_fix_ssh_dropin.bats
#
# STATED GAP: this file starts at the backup contract; the rest of
# _ssh_write_hardening_config (the staged sshd -t chain, the reload rollback) is
# exercised by the suite but not yet mutated.
#
# A mutation must not redirect a WRITE to a real /etc path — the verification
# container runs a real sshd and has its own /etc/ssh.

# ---- the backup contract ---------------------------------------------

# The pre-2026-08 shape: a failed snapshot blanked the variable and the write
# went ahead, so the reload-failure path had nothing to restore from.
run_case "backup/existing-failure-blanked" 1 \
    '        SSH_LAST_DROPIN_BACKUP=$(backup_file "$SSH_HARDENING_DROPIN") || return 1' \
    '        SSH_LAST_DROPIN_BACKUP=$(backup_file "$SSH_HARDENING_DROPIN" 2>/dev/null) || SSH_LAST_DROPIN_BACKUP=""'

# The first-run branch. Registering the drop-in as fix-created is the only
# thing that lets a plan-level rollback delete it; swallowing the failure
# leaves the file on the host after the operator asked to undo everything.
run_case "backup/first-run-failure-swallowed" 1 \
    '        backup_file "$SSH_HARDENING_DROPIN" >/dev/null || return 1' \
    '        backup_file "$SSH_HARDENING_DROPIN" >/dev/null 2>&1 || true'

# The "NEW" marker drives this module's own reload-failure rollback, which is
# a different mechanism from the plan-level one above. Both are needed.
run_case "backup/new-marker-dropped" 1 \
    '        SSH_LAST_DROPIN_BACKUP="NEW"' \
    '        SSH_LAST_DROPIN_BACKUP=""'

# ---- the legacy migration and a write over this session's own file ------------

# The migration must be undoable: without either snapshot a rollback leaves 00-
# with the legacy content and no 99-, a config different from before the plan.
run_case "migrate/legacy-not-backed-up" 1 \
    '    backup_file "$SSH_HARDENING_DROPIN_LEGACY" >/dev/null || return 1' \
    '    :'

run_case "migrate/new-name-not-registered" 1 \
    '    backup_file "$SSH_HARDENING_DROPIN" >/dev/null || return 1' \
    '    :'

run_case "write/own-copy-not-kept" 1 \
    '            SSH_LAST_DROPIN_BACKUP="PREV"' \
    '            :'

run_case "rollback/own-copy-not-restored" 1 \
    "        if printf '%s\\n' \"\$SSH_LAST_DROPIN_PREV\" > \"\$SSH_HARDENING_DROPIN\"; then" \
    '        if true; then'
