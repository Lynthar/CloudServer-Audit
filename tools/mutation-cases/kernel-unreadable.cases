# Mutation cases: tests/test_query_failure_honesty.bats against modules/kernel.sh.
# mutate-suite: modules/kernel.sh tests/test_query_failure_honesty.bats
#
# Zero readable sysctls must not be crowned "network params OK".

# Make the unreadable branch unreachable: total_issues==0 with passed==0
# then falls through to the green network_params_ok again.
run_case "kernel/unreadable-branch-dead" 1 \
    "        if (( passed == 0 )); then" \
    "        if (( passed < 0 )); then"

# A firewall query that failed must read as unknown, not as unfiltered — the
# latter is a medium "IPv6 firewall missing" finding on a host that could not
# be asked. Occurrence 2: the first is _kernel_check_aslr's catch-all.
run_case "kernel/ipv6-fw-unknown-reads-unfiltered" 2 \
    '        *) echo "unknown" ;;' \
    '        *) echo "unfiltered" ;;'

# The audit arm for the unknown answer must exist: without it the case falls
# through and nothing is emitted, which the suite's emit test refutes.
run_case "kernel/ipv6-firewall-unreadable-arm-dead" 1 \
    '            unknown)' \
    '            never_this_value)'

# A filtering backend read as none: firewalld hosts get "missing" again.
run_case "kernel/ipv6-fw-filtered-reads-unfiltered" 1 \
    '        0) echo "filtered" ;;' \
    '        0) echo "unfiltered" ;;'
