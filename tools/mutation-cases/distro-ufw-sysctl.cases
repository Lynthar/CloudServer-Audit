# Mutation cases: tests/test_fix_kernel.bats against core/distro.sh.
# mutate-suite: core/distro.sh tests/test_fix_kernel.bats
#
# fw_ufw_sysctl_file reads IPT_SYSCTL as data; the fix test names it quoted.

run_case "ufw-sysctl/defaults-unread" 1 \
    '    [[ -r "$DISTRO_UFW_DEFAULTS" ]] || return 0' \
    '    return 0'

run_case "ufw-sysctl/quotes-kept" 1 \
    '         END { gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", v); print v }'"'"' "$DISTRO_UFW_DEFAULTS"' \
    '         END { print v }'"'"' "$DISTRO_UFW_DEFAULTS"'
