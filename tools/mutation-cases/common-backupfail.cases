# Mutation cases: tests/test_query_failure_honesty.bats against core/common.sh.
# mutate-suite: core/common.sh tests/test_query_failure_honesty.bats
#
# backup_file: a backup that could not be taken must be a loud failure.

# Un-check the cp: the pre-2026-08 shape, where a failed copy fell through
# to the success log + path echo and the fix proceeded with no way back.
run_case "backupfile/cp-unchecked" 1 \
    "            || ! cp -p \"\$file\" \"\$partial\"; then" \
    "            || ! { cp -p \"\$file\" \"\$partial\" 2>/dev/null || true; }; then"
