# Mutation cases: tests/test_filesystem_umask.bats against modules/filesystem.sh —
# the umask AUDIT helpers, as opposed to the fixes (filesystem.cases, paired with
# test_fix_filesystem.bats).
# mutate-suite: modules/filesystem.sh tests/test_filesystem_umask.bats
#
# Two of the tests pinned here could not run at all until FS_LOGIN_DEFS and
# FS_PAM_SESSION_FILES became module variables: one skipped on every host that has
# /etc/login.defs (i.e. all of CI) and the other asserted only that a function
# existed.

run_case "usergroups/default-flipped" 1 \
    '    echo "${val:-yes}"' \
    '    echo "${val:-no}"'

run_case "usergroups/value-not-lowercased" 1 \
    '        val=$(grep -E "^USERGROUPS_ENAB" "$FS_LOGIN_DEFS" 2>/dev/null | awk '"'"'{print tolower($2)}'"'"')' \
    '        val=$(grep -E "^USERGROUPS_ENAB" "$FS_LOGIN_DEFS" 2>/dev/null | awk '"'"'{print $2}'"'"')'

run_case "pam/comment-not-skipped" 1 \
    "        grep -qE '^[[:space:]]*session[[:space:]]+[^#]*pam_umask\\.so' \"\$f\" 2>/dev/null && return 0" \
    "        grep -q 'pam_umask' \"\$f\" 2>/dev/null && return 0"

run_case "pam/any-session-line-matches" 1 \
    "        grep -qE '^[[:space:]]*session[[:space:]]+[^#]*pam_umask\\.so' \"\$f\" 2>/dev/null && return 0" \
    "        grep -qE '^[[:space:]]*session' \"\$f\" 2>/dev/null && return 0"

run_case "pam/only-the-first-file-checked" 1 \
    '    for f in "${FS_PAM_SESSION_FILES[@]}"; do' \
    '    for f in "${FS_PAM_SESSION_FILES[0]}"; do'

run_case "effective/usergroups-rewrite-dropped" 1 \
    '        echo "${raw:0:1}${raw:1:1}${raw:1:1}${raw:3:1}"' \
    '        echo "$raw"'

run_case "effective/empty-default-dropped" 1 \
    '    [[ -z "$raw" ]] && raw="022"' \
    '    :'

# ---- what _fs_audit_umask reports (text only; the branch is untouched) ----

run_case "report/rewrite-stated-as-fact" 1 \
    '        desc="$desc, possibly effective=$effective (USERGROUPS_ENAB=$usergroups may make pam_umask mirror owner bits onto group bits for private-group users; confirm with '"'"'umask'"'"' in a login shell)"' \
    '        desc="$desc, effective=$effective (USERGROUPS_ENAB=$usergroups rewrites group bits)"'

run_case "report/raw-comparison-restored" 1 \
    '    elif [[ "$normalized" != "$effective" ]]; then' \
    '    elif [[ "$configured" != "$effective" ]]; then'

run_case "report/pam-gate-removed" 1 \
    '    if (( pam_umask_on == 0 )); then' \
    '    if false; then'

run_case "report/pam-info-check-always" 2 \
    '    if (( pam_umask_on == 0 )); then' \
    '    if true; then'

# The severity branch must NOT move — these two prove the suite would catch it.
run_case "report/branch-keyed-on-configured" 1 \
    '    if _fs_umask_is_strict "$effective"; then' \
    '    if _fs_umask_is_strict "$configured"; then'

run_case "report/default-branch-widened" 1 \
    '    elif [[ "$effective" == "0022" || "$effective" == "0002" ]]; then' \
    '    elif true; then'
