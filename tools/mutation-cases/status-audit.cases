# Mutation cases: tests/test_status_last_audit.bats against core/engine.sh.
# mutate-suite: core/engine.sh tests/test_status_last_audit.bats
#
# An audit pass records itself, and status reads it back.

run_case "record/not-written" 1 \
    '    state_record_audit "$(calculate_score)" "$complete" \' \
    '    : "$(calculate_score)" "$complete" \'
run_case "record/always-complete" 1 \
    '    (( ${#VPSSEC_MODULES_FAILED[@]} == 0 )) || complete=false' \
    '    :'
run_case "status/incomplete-unsaid" 1 \
    '        elif [[ "$audit_complete" == "false" ]]; then' \
    '        elif false; then'
run_case "status/never-untranslated" 1 \
    "    never=\$(i18n 'status.never')" \
    '    never=never'

# A user who cannot read state/ sees the version line and then nothing.
run_case "status/unreadable-state-silent" 1 \
    '    if [[ -d "${VPSSEC_STATE}" && ! -r "${VPSSEC_STATE}" ]]; then' \
    '    if false; then'
run_case "status/unreadable-state-unsaid" 1 \
    "        print_msg \"  \$(i18n 'status.state_unreadable')\"" \
    '        print_msg ""'
