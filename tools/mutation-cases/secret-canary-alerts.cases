# Mutation cases: tests/test_secret_canary.bats against modules/alerts.sh.
# mutate-suite: modules/alerts.sh tests/test_secret_canary.bats
#
# The alerts audit reports whether a webhook and an email are configured, never
# their values. This suite is its only guard.

run_case "presence/webhook-value-reported" 1 \
    "            [[ -n \"\$webhook\" ]] && webhook_status=\$(i18n 'common.yes')" \
    "            [[ -n \"\$webhook\" ]] && webhook_status=\"\$webhook\""

run_case "presence/email-value-reported" 1 \
    "            [[ -n \"\$email\" ]] && email_status=\$(i18n 'common.yes')" \
    "            [[ -n \"\$email\" ]] && email_status=\"\$email\""
