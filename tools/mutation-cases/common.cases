# Mutation cases: tests/test_backup_mode_restore.bats against core/common.sh —
# the backup half of the mode-preservation contract.
# mutate-suite: core/common.sh tests/test_backup_mode_restore.bats
#
# The restore half is state.cases against core/state.sh: the runner mutates one
# source file per invocation, so the two sides are two files by necessity.

run_case "modes/never-recorded" 1 \
    '        backup_track_mode "$file" "$backup_dir"' \
    '        :'

run_case "modes/intermediate-overwrites-original" 1 \
    '    _backup_mode_recorded "$path" "$manifest" && return 0' \
    '    :'

run_case "modes/manifest-columns-swapped" 1 \
    '    printf '"'"'%s %s\n'"'"' "$mode" "$path" >> "$manifest" || return 0' \
    '    printf '"'"'%s %s\n'"'"' "$path" "$mode" >> "$manifest" || return 0'

run_case "modes/recorded-after-the-copy" 1 \
    '    mode=$(stat -c '"'"'%a'"'"' "$path" 2>/dev/null) || return 0' \
    '    mode=600'

# The mutant keeps the trailing `|| \` so the follow-up log_warn line stays
# syntactically attached and inert; dropping it detaches the continuation and
# breaks the file rather than the behaviour.
run_case "modes/backup-copy-left-readable" 1 \
    '        chmod 600 "$backup_path" 2>/dev/null || \' \
    '        : || \'
