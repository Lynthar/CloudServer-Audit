# Mutation cases: tests/test_entry_path.bats against vpssec.
# mutate-suite: vpssec tests/test_entry_path.bats
#
# The PATH the entry script runs everything with: the sbin directories appended
# when missing, the given order kept, nothing repeated.

# Never completed: cron's PATH hides sysctl, sshd and ufw again.
run_case "path/not-completed" 1 \
    '_vpssec_complete_path' \
    ':'

# Appended even when present: a full PATH gains duplicates.
run_case "path/duplicates" 1 \
    '        [[ ":${PATH:-}:" == *":$dir:"* ]] || PATH="${PATH:+$PATH:}$dir"' \
    '        PATH="${PATH:+$PATH:}$dir"'

# Prepended: the sbin directories outrank what the caller put first.
run_case "path/prepended" 1 \
    '        [[ ":${PATH:-}:" == *":$dir:"* ]] || PATH="${PATH:+$PATH:}$dir"' \
    '        [[ ":${PATH:-}:" == *":$dir:"* ]] || PATH="$dir${PATH:+:$PATH}"'
