# Mutation cases: tests/test_backup_mode_restore.bats against core/state.sh — the
# restore half of the mode-preservation contract; the backup half is common.cases.
# mutate-suite: core/state.sh tests/test_backup_mode_restore.bats

run_case "modes/mode-never-reapplied" 1 \
    '        _backup_restore_mode "$original_path" "$modes_manifest"' \
    '        :'

run_case "modes/chmod-not-issued" 1 \
    '    if ! chmod "$mode" "$path" 2>/dev/null; then' \
    '    if false; then'

run_case "modes/manifest-path-wrong" 1 \
    '    local modes_manifest="${backup_dir}/${VPSSEC_MODES_MANIFEST}"' \
    '    local modes_manifest="${backup_dir}/.vpssec_modes_typo"'

# The manifest sits at the session root, so its path relative to the backup
# directory is ".vpssec_modes", which the restore walk maps to /.vpssec_modes.
# Dropping the exclusion writes a file into / on the test host; the suite's
# assertion removes it first for exactly that reason.
run_case "modes/manifest-restored-into-root" 1 \
    "    done < <(find \"\$backup_dir\" -type f ! -name '.vpssec_created' ! -name '.vpssec_modes' -print0)" \
    "    done < <(find \"\$backup_dir\" -type f ! -name '.vpssec_created' -print0)"

# There is deliberately NO case for the `[[ -n "$mode" ]]` guard in
# _backup_restore_mode. Its only observable effect is one log line: with the guard
# gone, an empty mode reaches `chmod "" path`, which fails, and that failure is
# swallowed by design so the restore can continue.
