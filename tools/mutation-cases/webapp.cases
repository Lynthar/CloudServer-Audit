# Mutation cases: tests/test_fix_webapp_nginx.bats against modules/webapp.sh.
# mutate-suite: modules/webapp.sh tests/test_fix_webapp_nginx.bats
#
# The occurrence index matters where the audit and the fix share a line verbatim;
# the rule and the rest of the runner's contract are in tools/mutate-suite.sh's header.

run_case "tokens/comment-counts-as-configured" 1 \
    "    if grep -qE '^[^#]*server_tokens[[:space:]]+off' \"\$NGINX_CONF\" 2>/dev/null; then" \
    "    if grep -qE 'server_tokens[[:space:]]+off' \"\$NGINX_CONF\" 2>/dev/null; then"

run_case "tokens/duplicate-instead-of-replace" 1 \
    "    if grep -qE '^[^#]*server_tokens[[:space:]]' \"\$NGINX_CONF\" 2>/dev/null; then" \
    '    if false; then'

run_case "tokens/no-backup" 1 \
    '    bak=$(backup_file "$NGINX_CONF") || return 1' \
    '    bak=""'

run_case "tokens/no-rollback-on-reject" 1 \
    '            cp -p "$bak" "$NGINX_CONF" && \' \
    '            true && \'

run_case "tokens/validation-gate-removed" 1 \
    '    if ! test_output=$(nginx -t 2>&1); then' \
    '    if false; then'

# A reload that failed leaves the edit on disk but not live, and the old code
# reported that as a completed fix.
run_case "tokens/reload-unchecked" 1 \
    '    if ! systemctl reload nginx 2>/dev/null; then' \
    '    if ! systemctl reload nginx 2>/dev/null && false; then'

# Without nginx's own message the operator gets "configuration test failed" and
# no file, no line.
run_case "tokens/nginx-message-swallowed" 1 \
    '        [[ -n "$test_output" ]] && print_info "$(i18n '"'"'webapp.nginx_test_output'"'"' "msg=$test_output")"' \
    '        :'

run_case "tokens/write-not-persisted" 1 \
    '    if ! write_file_atomic "$NGINX_CONF" "$updated"; then' \
    '    if false; then'

run_case "headers/backup-guarded-again" 1 \
    '    bak=$(backup_file "$headers_conf") || return 1' \
    '    [[ -f "$headers_conf" ]] && { bak=$(backup_file "$headers_conf") || return 1; }'

run_case "headers/xss-auditor-re-enabled" 1 \
    'add_header X-XSS-Protection "0" always;' \
    'add_header X-XSS-Protection "1; mode=block" always;'

run_case "headers/rejected-dropin-left-behind" 1 \
    '            rm -f "$headers_conf"' \
    '            :'

run_case "headers/validation-gate-removed" 2 \
    '    if ! test_output=$(nginx -t 2>&1); then' \
    '    if false; then'

run_case "headers/reload-unchecked" 2 \
    '    if ! systemctl reload nginx 2>/dev/null; then' \
    '    if ! systemctl reload nginx 2>/dev/null && false; then'

# Reporting "created" over the operator's own drop-in is how the replacement
# went unnoticed: the file is backed up, but nothing said it had been replaced.
run_case "headers/replacement-reported-as-created" 1 \
    '    if [[ "$pre_existed" == "true" ]]; then' \
    '    if false; then'

run_case "hsts/backup-skipped" 1 \
    '    backup_file "$hsts_conf" >/dev/null || return 1' \
    '    :'

# The two defects worth pinning are the two halves that used to be conflated: a case
# replacing the print_warn with `return 0` is a no-op on the status now that
# FIX_TEMPLATE_ONLY lets the success path return 0 legitimately.
run_case "hsts/instruction-not-printed" 1 \
    "    print_warn \"\$(i18n 'webapp.hsts_warning')\"" \
    '    :'

# Occurrence 4 of five: #1 webapp_audit, #2 server_tokens, #3 security_headers,
# #5 the SSL fix. Recount this index whenever a fix gains a top-level return 0.
run_case "hsts/success-reported-as-failure" 4 \
    '    return 0' \
    '    return 1'

run_case "ssl/backup-skipped" 1 \
    '    backup_file "$ssl_conf" >/dev/null || return 1' \
    '    :'

run_case "ssl/written-into-conf.d" 1 \
    '    local ssl_conf="$NGINX_SNIPPETS/ssl-security.conf"' \
    '    local ssl_conf="$NGINX_CONFD/ssl-security.conf"'

run_case "ssl/weak-protocol-offered" 1 \
    'ssl_protocols TLSv1.2 TLSv1.3;' \
    'ssl_protocols TLSv1 TLSv1.2 TLSv1.3;'

run_case "ssl/validation-ignored" 1 \
    '    if command -v nginx >/dev/null 2>&1 && ! test_output=$(nginx -t 2>&1); then' \
    '    if false; then'

run_case "dispatch/unknown-id-succeeds" 1 \
    '            log_warn "Unknown fix_id: $fix_id"' \
    '            return 0'

# A swallowed backup failure lets the fix rewrite /etc with no way back.
run_case "rollback/backup-failure-swallowed" 1 \
    '    bak=$(backup_file "$NGINX_CONF") || return 1' \
    '    bak=$(backup_file "$NGINX_CONF" 2>/dev/null) || bak=""'
