# Mutation cases: tests/test_query_failure_honesty.bats against core/distro.sh.
# mutate-suite: core/distro.sh tests/test_query_failure_honesty.bats
#
# fw_backend answers "none" only when every installed tool answered. Occurrences
# of `failed=1` are the ufw, nft and iptables probes, in that order.

run_case "firewall/ufw-failure-ignored" 1 \
    '            failed=1' \
    '            :'

run_case "firewall/nft-failure-ignored" 2 \
    '            failed=1' \
    '            :'

run_case "firewall/iptables-failure-ignored" 3 \
    '            failed=1' \
    '            :'

run_case "firewall/failure-still-reads-none" 1 \
    '    (( failed == 0 )) || return 1' \
    '    :'

# A drop policy on the input hook no longer counts as filtering (nft, iptables).
run_case "firewall/nft-drop-policy-ignored" 1 \
    '            if (input && $0 ~ /policy[ \t]+(drop|reject)/) f = 1' \
    '            if (0) f = 1'

run_case "firewall/iptables-drop-policy-ignored" 1 \
    '        /^-P INPUT (DROP|REJECT)/ { f = 1; next }' \
    '        /^-P INPUT (DROP|REJECT)/ { next }'

# fail2ban's table, or the chains of fail2ban, ufw and tailscale, read as a
# firewall again: ufw.disabled and ufw.no_firewall go unreported.
run_case "firewall/f2b-table-filters" 1 \
    '            input = !f2b' \
    '            input = 1'

run_case "firewall/nft-component-jumps-filter" 1 \
    '        /(jump|goto)[ \t]+(f2b-|ufw6?-|ts-)/ { next }' \
    '        /(jump|goto)[ \t]+(nomatch-)/ { next }'

run_case "firewall/iptables-component-jumps-filter" 1 \
    '            if (t == "" || t ~ /^(f2b-|ufw6?-|ts-)/) next' \
    '            if (t == "") next'

# Any rule counts again, so accept-only rules under an accept policy pass.
run_case "firewall/nft-accept-filters" 1 \
    '        tolower($0) ~ /(^|[^a-z_-])(drop|reject|queue|jump|goto)([^a-z_-]|$)/ { f = 1 }' \
    '        !/^[ \t]*$/ { f = 1 }'

run_case "firewall/iptables-accept-filters" 1 \
    '            if (t !~ /^(ACCEPT|RETURN|LOG|NFLOG|ULOG|MARK|CONNMARK|CT|TRACE|AUDIT|SET|CLASSIFY|TCPMSS)$/) f = 1' \
    '            f = 1'

# A real drop rule no longer counts as filtering.
run_case "firewall/nft-drop-rule-ignored" 1 \
    '        tolower($0) ~ /(^|[^a-z_-])(drop|reject|queue|jump|goto)([^a-z_-]|$)/ { f = 1 }' \
    '        0 { f = 1 }'

# firewalld installed but unqueryable is read as not running: an error answers
# the question. (The `failed=1` indexes above count only the 12-space probes.)
run_case "firewall/firewalld-failure-ignored" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if false; then'

# Every host whose systemctl cannot answer — containers too — becomes unknown.
run_case "firewall/firewalld-absent-flagged" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )); then'

# A plain "not running" (exit 3) on a firewalld host is read as a failed query.
run_case "firewall/firewalld-inactive-flagged" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if _fw_firewalld_installed; then'
