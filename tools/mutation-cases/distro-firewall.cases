# Mutation cases: tests/test_query_failure_honesty.bats against core/distro.sh.
# mutate-suite: core/distro.sh tests/test_query_failure_honesty.bats
#
# fw_backend answers "none" only when every installed tool answered. Occurrences
# of `failed=1` are the ufw, nft and iptables probes, in that order.

run_case "firewall/ufw-failure-ignored" 1 \
    '            failed=1' \
    '            :'

run_case "firewall/nft-failure-ignored" 2 \
    '            failed=1' \
    '            :'

run_case "firewall/iptables-failure-ignored" 3 \
    '            failed=1' \
    '            :'

run_case "firewall/failure-still-reads-none" 1 \
    '    (( failed == 0 )) || return 1' \
    '    :'

# With ufw installed but off, tables that filter nothing on input read as an
# nftables firewall again, and ufw.disabled goes unreported.
run_case "firewall/ufw-off-ignored" 1 \
    '            if [[ -n "$out" ]] && { (( ufw_off == 0 )) || _fw_nft_input_filters; }; then' \
    '            if [[ -n "$out" ]]; then'

run_case "firewall/ufw-off-never-set" 1 \
    '            ufw_off=1' \
    '            :'

# A ufw whose status query failed is treated as off, and an unknown state
# decides the backend.
run_case "firewall/ufw-state-unknown-trusted" 1 \
    '            if [[ -n "$out" ]] && { (( ufw_off == 0 )) || _fw_nft_input_filters; }; then' \
    '            if [[ -n "$out" ]] && { false || _fw_nft_input_filters; }; then'

# A drop policy on the input hook no longer counts as filtering.
run_case "firewall/drop-policy-ignored" 1 \
    '        /hook[ \t]+input/ { input = 1; if ($0 ~ /policy[ \t]+(drop|reject)/) f = 1; next }' \
    '        /hook[ \t]+input/ { input = 1; next }'

# Jumps into ufw's emptied chains count as filtering again.
run_case "firewall/ufw-jumps-filter" 1 \
    '        input && /jump[ \t]+ufw6?-/ { next }' \
    '        input && /jump[ \t]+nomatch-/ { next }'

# A real input rule no longer counts as filtering.
run_case "firewall/real-rule-ignored" 1 \
    '        input && !/^[ \t]*$/ { f = 1 }' \
    '        input && 0 { f = 1 }'

# A ruleset that cannot be listed reads as unfiltered, turning an error into none.
run_case "firewall/listing-failure-unfiltered" 1 \
    '    ruleset=$(nft list ruleset 2>/dev/null) || return 0' \
    '    ruleset=$(nft list ruleset 2>/dev/null) || return 1'

# firewalld installed but unqueryable is read as not running: an error answers
# the question. (The `failed=1` indexes above count only the 12-space probes.)
run_case "firewall/firewalld-failure-ignored" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if false; then'

# Every host whose systemctl cannot answer — containers too — becomes unknown.
run_case "firewall/firewalld-absent-flagged" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )); then'

# A plain "not running" (exit 3) on a firewalld host is read as a failed query.
run_case "firewall/firewalld-inactive-flagged" 1 \
    '    if (( fwd_rc != 3 && fwd_rc != 4 )) && _fw_firewalld_installed; then' \
    '    if _fw_firewalld_installed; then'
