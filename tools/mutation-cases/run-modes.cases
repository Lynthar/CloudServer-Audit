# Mutation cases: tests/test_run_modes.bats against run.sh.
# mutate-suite: run.sh tests/test_run_modes.bats
#
# Every failure modelled here is silent: the runner would go on to harden the
# host and then delete the backups, reporting success the whole way. Only an
# assertion on the refusal itself can tell the difference.

# The gate stops matching, so guide reaches the download and then the fix path.
run_case "run-modes/gate-lets-guide-through" 1 \
    '        guide|rollback) ;;' \
    '        rollback) ;;'

# Refusing with 4 would tell automation "this host cannot be hardened", which
# is a different diagnosis from "you used the wrong entry point".
run_case "run-modes/refuse-with-host-code" 1 \
    '    exit 2' \
    '    exit 4'

# The refusal stops naming a way forward, leaving the operator with a no.
run_case "run-modes/no-way-forward" 1 \
    '        echo "    curl -fsSL https://raw.githubusercontent.com/${VPSSEC_REPO}/main/install.sh | sudo bash"' \
    '        echo ""'

# The gate moves after the download: a release is fetched only to be declined.
run_case "run-modes/refuse-after-download" 1 \
    '    _refuse_stateful_mode "$mode"' \
    '    :'

# Without the marker vpssec cannot tell it runs from a tree deleted on exit, and
# the mode menu leads straight into guide.
run_case "run-modes/marker-not-exported" 1 \
    '    export VPSSEC_ONESHOT=1' \
    '    :'

# vpssec's status no longer held until after the copy: an incomplete audit (3)
# ends run.sh under errexit, and the trap deletes the reports it saved.
run_case "run/status-not-held" 1 \
    '            bash ./vpssec "$mode" || rc=$?' \
    '            bash ./vpssec "$mode"'

# vpssec executed directly: a /tmp mounted noexec refuses the tree with 126.
# One case per call site, since each argument shape takes its own branch.
run_case "run-modes/exec-mode-and-args" 1 \
    '            bash ./vpssec "$mode" "${args[@]}" || rc=$?' \
    '            ./vpssec "$mode" "${args[@]}" || rc=$?'

run_case "run-modes/exec-mode-only" 1 \
    '            bash ./vpssec "$mode" || rc=$?' \
    '            ./vpssec "$mode" || rc=$?'

run_case "run-modes/exec-args-only" 1 \
    '            bash ./vpssec "${args[@]}" || rc=$?' \
    '            ./vpssec "${args[@]}" || rc=$?'

run_case "run-modes/exec-bare" 1 \
    '            bash ./vpssec || rc=$?' \
    '            ./vpssec || rc=$?'
