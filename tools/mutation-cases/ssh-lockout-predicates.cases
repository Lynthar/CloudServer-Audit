# Mutation cases: tests/test_ssh_lockout_predicates.bats against modules/ssh.sh.
# mutate-suite: modules/ssh.sh tests/test_ssh_lockout_predicates.bats
#
# The lockout gates' predicates on real inputs. ssh-gates.cases covers how the
# gates combine them; a survivor here is a predicate that answers "can log in"
# for an account sshd or the system would turn away.

run_case "account/nologin-shell-counted" 1 \
    '        */nologin|*/false) return 1 ;;' \
    '        */nologin|*/false) ;;'

run_case "account/expiry-ignored" 1 \
    '        (( expire <= today )) && return 1' \
    '        :'

run_case "keylogin/root-refusal-ignored" 1 \
    '        [[ "${prl,,}" == "no" ]] && return 1' \
    '        :'

run_case "keylogin/pubkey-off-ignored" 1 \
    '    _ssh_pubkey_enabled "$user" || return 1' \
    '    :'
