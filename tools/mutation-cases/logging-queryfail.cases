# Mutation cases: tests/test_query_failure_honesty.bats against modules/logging.sh.
# mutate-suite: modules/logging.sh tests/test_query_failure_honesty.bats
#
# journalctl failing must not read as "0 failed logins".

# Swallow journalctl's exit status again: the getter then reports 0 on a
# host whose journal cannot be read, and the audit prints ssh_logs_ok.
run_case "logging/journalctl-rc-swallowed" 1 \
    '    out=$(journalctl "$@" --since "24 hours ago" 2>&1) || return 1' \
    '    out=$(journalctl "$@" --since "24 hours ago" 2>&1) || true'

# No journal files: journalctl says so and exits 0.
run_case "logging/no-journal-reads-quiet" 1 \
    "    grep -q '^No journal files were found' <<<\"\$out\" && return 1" \
    '    :'

# Every line counted, not the commands: "-- No entries --" becomes one sudo
# event on every quiet host, and one sudo run three.
run_case "logging/sudo-counts-lines" 1 \
    "    count=\$(grep -c 'COMMAND=' <<<\"\$out\" 2>/dev/null) || count=0" \
    "    count=\$(grep -c . <<<\"\$out\" 2>/dev/null) || count=0"
