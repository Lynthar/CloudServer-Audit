# Mutation cases: tests/test_query_failure_honesty.bats against modules/ufw.sh.
# mutate-suite: modules/ufw.sh tests/test_query_failure_honesty.bats
#
# A firewall query that failed is unknown, never "no firewall".

run_case "ufw/unknown-backend-reads-none" 1 \
    "    active_fw=\$(fw_backend) || active_fw=\"unknown\"" \
    "    active_fw=\$(fw_backend) || active_fw=\"none\""
