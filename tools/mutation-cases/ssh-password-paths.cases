# Mutation cases: tests/test_ssh_password_paths.bats against modules/ssh.sh.
# mutate-suite: modules/ssh.sh tests/test_ssh_password_paths.bats
#
# Each case lets a password through keyboard-interactive read as "disabled",
# or offers the fix that cannot close that path.

run_case "kbdint/not-a-password-path" 1 \
    '    [[ "${value,,}" == "yes" ]] || _ssh_kbdint_password_path' \
    '    [[ "${value,,}" == "yes" ]]'

run_case "kbdint/pam-not-required" 2 \
    '    [[ "${value,,}" == "yes" ]] || return 1' \
    '    :'

run_case "kbdint/any-not-open" 1 \
    '    [[ "${value,,}" == "any" ]] && return 0' \
    '    :'

run_case "kbdint/key-lists-ignored" 1 \
    '            [[ "${m%%:*}" == keyboard-interactive || "$m" == password ]] || only=0' \
    '            :'

run_case "kbdint/submethod-unrecognised" 1 \
    '            [[ "${m%%:*}" == keyboard-interactive || "$m" == password ]] || only=0' \
    '            [[ "$m" == keyboard-interactive || "$m" == password ]] || only=0'

run_case "audit/fix-offered-anyway" 1 \
    '    if _ssh_kbdint_password_path; then' \
    '    if false; then'

run_case "fix/runs-anyway" 2 \
    '    if _ssh_kbdint_password_path; then' \
    '    if false; then'
