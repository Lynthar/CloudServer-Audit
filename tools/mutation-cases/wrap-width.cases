# Mutation cases: tests/test_guide_plan_contract.bats against core/common.sh.
# mutate-suite: core/common.sh tests/test_guide_plan_contract.bats
#
# wrap_to_width, which the plan preview's lines pass through before whiptail:
# newt counts code points, so a CJK line measured that way overran the box.

run_case "wrap/code-points-counted" 1 \
    '        if (( b >= 0x20 && b < 0x7F )); then cw=1; else cw=$(_display_width "$ch"); fi' \
    '        cw=1'

# A character wider than the line used to cost an empty line before it.
run_case "wrap/empty-line-before-wide-char" 1 \
    '        if (( w > 0 && w + cw > target )); then' \
    '        if (( w + cw > target )); then'

run_case "wrap/last-line-dropped" 1 \
    "    printf '%s\n' \"\$line\"" \
    '    :'

# Under the C locale bash slices by bytes: a CJK character's three bytes taken
# one at a time come out as invalid UTF-8.
run_case "wrap/bytes-taken-as-characters" 1 \
    '        if (( b >= 0xF0 )); then len=4; elif (( b >= 0xE0 )); then len=3' \
    '        if (( b >= 0xF0 )); then len=4; elif (( b >= 0xE0 )); then len=1'

run_case "truncate/one-byte-dropped" 1 \
    '        (( b >= 0x80 && b < 0xC0 )) || break' \
    '        break'

# Occurrences 2 and 3 of `local LC_ALL=C` (the first is _display_width's): left in
# the caller's UTF-8 locale, bash hands back code points where bytes are expected.
run_case "truncate/locale-trusted" 2 \
    '    local LC_ALL=C' \
    '    :'

run_case "wrap/locale-trusted" 3 \
    '    local LC_ALL=C' \
    '    :'

# An ASCII word reaching the edge mid-line is cut there again ("M" / "axAuthTries").
run_case "wrap/word-cut-mid-line" 1 \
    '            if (( word > 0 )); then' \
    '            if false; then'

run_case "wrap/word-start-not-recorded" 1 \
    '            (( word < 0 )) && word=${#line} word_w=w' \
    '            :'
