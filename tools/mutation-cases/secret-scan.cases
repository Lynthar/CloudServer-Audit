# Mutation cases: tests/test_secret_scan.bats against core/common.sh.
# mutate-suite: core/common.sh tests/test_secret_scan.bats
#
# The credential patterns, the per-occurrence count, and the cloud tier that
# decides whether the IMDS audit runs the scan at all.

# aws-or-compatible maps to no tier, and the IMDS audit returns before the scan.
run_case "tier/compatible-imds-unknown" 1 \
    '        aws|aws-or-compatible|azure|gcp|alibaba|tencent|huawei|oracle)' \
    '        aws|azure|gcp|alibaba|tencent|huawei|oracle)'

# Lines are counted, not keys.
run_case "count/by-line" 1 \
    '        n=$(grep -o "$flags" -- "$re" <<<"$content" 2>/dev/null | wc -l) || n=0' \
    '        n=$(grep -c "$flags" -- "$re" <<<"$content" 2>/dev/null) || n=0'

run_case "pgp/block-suffix-dropped" 1 \
    "    'private_key -E -----BEGIN[[:space:]]+(RSA|OPENSSH|EC|DSA|ENCRYPTED|PGP)?[[:space:]]?PRIVATE[[:space:]]+KEY([[:space:]]+BLOCK)?-----'" \
    "    'private_key -E -----BEGIN[[:space:]]+(RSA|OPENSSH|EC|DSA|ENCRYPTED|PGP)?[[:space:]]?PRIVATE[[:space:]]+KEY-----'"

run_case "aws-secret/case-sensitive" 1 \
    "    \"aws_secret_key -iE aws_secret_access_key[\\\"']?[[:space:]]*[:=][[:space:]]*[\\\"']?[A-Za-z0-9/+=]{40}\"" \
    "    \"aws_secret_key -E aws_secret_access_key[\\\"']?[[:space:]]*[:=][[:space:]]*[\\\"']?[A-Za-z0-9/+=]{40}\""

run_case "aws-secret/equals-only" 1 \
    "    \"aws_secret_key -iE aws_secret_access_key[\\\"']?[[:space:]]*[:=][[:space:]]*[\\\"']?[A-Za-z0-9/+=]{40}\"" \
    "    \"aws_secret_key -iE aws_secret_access_key[[:space:]]*=[[:space:]]*[A-Za-z0-9/+=]{40}\""

run_case "alibaba/unmatched" 1 \
    "    'alibaba_access_key -E LTAI[A-Za-z0-9]{12,}'" \
    "    'alibaba_access_key -E LTAI[A-Za-z0-9]{20}'"

run_case "tencent/unmatched" 1 \
    "    'tencent_secret_id -E AKID[A-Za-z0-9]{32}'" \
    "    'tencent_secret_id -E AKIDX[A-Za-z0-9]{32}'"

# Only the personal access token form: OAuth and refresh tokens slip through.
run_case "digitalocean/pat-only" 1 \
    "    'digitalocean_token -E do[opr]_v1_[a-f0-9]{64}'" \
    "    'digitalocean_token -E dop_v1_[a-f0-9]{64}'"
