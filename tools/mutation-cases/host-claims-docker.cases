# Mutation cases for tests/test_audit_host_claims.bats against modules/docker.sh.
#
#   bash tools/mutate-suite.sh modules/docker.sh \
#        tests/test_audit_host_claims.bats tools/mutation-cases/host-claims-docker.cases
#
# The defect being pinned: "cannot reach a daemon" was spelled the same as
# "Docker is not installed", and the latter is a PASSED check that skips every
# container finding. Rootless Docker answers that way to every sudo'd audit.

# Without the three-way, an unreachable daemon goes back to a green tick.
run_case "claims/unreachable-collapses-to-not-installed" 1 \
    '        if check_command docker || [[ -n "$runtime" ]]; then' \
    '        if false; then'

# Podman is never probed by the rest of the module, so this line is the only
# thing standing between a Podman host and "Docker is not installed".
run_case "claims/podman-not-probed" 1 \
    '    if check_command podman; then found+=("podman"); fi' \
    '    :'

# Rootless sockets live in the user's runtime dir; dropping the scan makes the
# most common unreachable case invisible again.
run_case "claims/rootless-socket-not-scanned" 1 \
    '        if [[ -S "/run/user/${uid}/docker.sock" ]] || \' \
    '        if false && \'
