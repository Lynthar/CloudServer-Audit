# Mutation cases: tests/test_fix_update.bats against modules/update.sh.
# mutate-suite: modules/update.sh tests/test_fix_update.bats
#
# The predicate cases at the end are the point of this file: the module used to carry
# its own copy of "are automatic updates effective", reachable only from the fix's
# postcondition, while the audit asked core/distro.sh. Reintroducing either copy must
# go red.

# ---- the path variables that make the fix reachable ------------------
# Pinned through backup_file (read-only) rather than write_file_atomic: an inlined
# literal on the WRITE would rewrite the container's own /etc/apt/apt.conf.d and
# leave every later case running against a changed host.

run_case "paths/auto-upgrades-inlined" 2 \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '    backup_file /etc/apt/apt.conf.d/20auto-upgrades >/dev/null || return 1'

run_case "paths/dropin-inlined" 1 \
    '    local uu_dropin="$UPDATE_UU_DROPIN"' \
    '    local uu_dropin="/etc/apt/apt.conf.d/52vpssec-unattended-security"'

# ---- the rollback contract -------------------------------------------

run_case "rollback/auto-upgrades-backup-skipped" 2 \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '    :'

run_case "rollback/auto-upgrades-backup-guarded-again" 2 \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '    [[ -f "$UPDATE_AUTO_UPGRADES_CONF" ]] && { backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1; }'

run_case "rollback/dropin-backup-skipped" 1 \
    '    backup_file "$uu_dropin" >/dev/null || return 1' \
    '    :'

run_case "rollback/dropin-backup-guarded-again" 1 \
    '    backup_file "$uu_dropin" >/dev/null || return 1' \
    '    [[ -f "$uu_dropin" ]] && { backup_file "$uu_dropin" >/dev/null || return 1; }'

# ---- write failures --------------------------------------------------

# The status check is broken with `&& false`: the write still runs and only its
# result is ignored, which is the defect.

run_case "write/auto-upgrades-status-unchecked" 1 \
    '    if ! write_file_atomic "$UPDATE_AUTO_UPGRADES_CONF" "$(_update_auto_upgrades_content "$current")"; then' \
    '    if ! write_file_atomic "$UPDATE_AUTO_UPGRADES_CONF" "$(_update_auto_upgrades_content "$current")" && false; then'

# ---- what an operator's 20auto-upgrades keeps --------------------------------

run_case "auto-upgrades/weekly-interval-reset" 1 \
    "                _auto_update_apt_interval_on \"\${BASH_REMATCH[2]}\" || line=\"APT::Periodic::\$key \\\"1\\\";\"" \
    "                line=\"APT::Periodic::\$key \\\"1\\\";\""

run_case "auto-upgrades/off-interval-left-off" 1 \
    "                _auto_update_apt_interval_on \"\${BASH_REMATCH[2]}\" || line=\"APT::Periodic::\$key \\\"1\\\";\"" \
    '                :'

run_case "auto-upgrades/missing-key-not-added" 1 \
    "        [[ -n \"\${seen[\$key]:-}\" ]] || out+=\"APT::Periodic::\$key \\\"1\\\";\"\$'\\n'" \
    '        :'

run_case "auto-upgrades/autoclean-written-twice" 1 \
    '                seen[AutocleanInterval]=1' \
    '                :'

run_case "write/dropin-status-unchecked" 1 \
    '    if ! write_file_atomic "$uu_dropin" "$dropin_text"; then' \
    '    if ! write_file_atomic "$uu_dropin" "$dropin_text" && false; then'

# ---- what the drop-in must say ---------------------------------------

run_case "config/periodic-flag-off" 1 \
    "        [[ -n \"\${seen[\$key]:-}\" ]] || out+=\"APT::Periodic::\$key \\\"1\\\";\"\$'\\n'" \
    "        [[ -n \"\${seen[\$key]:-}\" ]] || out+=\"APT::Periodic::\$key \\\"0\\\";\"\$'\\n'"

# The "50unattended-upgrades is left alone" test only asserts that a file at that
# path survives — which it would even if the fix wrote to the real /etc copy, since
# the test's tree is elsewhere. This case is what makes that test mean something:
# point the writer at the 50 conffile within the SAME tree and the assertion must fail.
run_case "config/writes-the-50-conffile" 1 \
    '    local uu_dropin="$UPDATE_UU_DROPIN"' \
    '    local uu_dropin="${UPDATE_UU_DROPIN%/*}/50unattended-upgrades"'

run_case "config/inherited-origins-not-cleared" 1 \
    "    printf '%s\\n' '#clear Unattended-Upgrade::Allowed-Origins;' \\" \
    "    printf '%s\\n' '// no clear' \\"

# Read after 50, any other key overrides what the operator set there.
run_case "config/overrides-operator-reboot" 1 \
    "\$(_update_security_origins_conf)\"" \
    "\$(_update_security_origins_conf; echo 'Unattended-Upgrade::Automatic-Reboot \"false\";')\""

run_case "config/debian-pattern-on-ubuntu" 1 \
    '    if [[ "$(detect_os)" == "ubuntu" ]]; then' \
    '    if false; then'

run_case "config/ubuntu-pattern-everywhere" 1 \
    '    if [[ "$(detect_os)" == "ubuntu" ]]; then' \
    '    if true; then'

# ---- the periodic driver ---------------------------------------------

run_case "service/upgrade-timer-not-enabled" 1 \
    '    for timer in apt-daily.timer apt-daily-upgrade.timer; do' \
    '    for timer in apt-daily.timer; do'

run_case "service/refresh-timer-not-enabled" 1 \
    '    for timer in apt-daily.timer apt-daily-upgrade.timer; do' \
    '    for timer in apt-daily-upgrade.timer; do'

run_case "service/timer-undo-not-recorded" 1 \
    '    (( ${#turned_on[@]} )) && record_undo update.enable_unattended "systemctl disable --now ${turned_on[*]}"' \
    '    :'

# Every timer named, on or not: the undo would turn off what the operator had on.
run_case "service/undo-names-timers-already-on" 1 \
    '            systemctl enable --now "$timer" 2>/dev/null || true' \
    '            systemctl enable --now "$timer" 2>/dev/null && turned_on+=("$timer")'

# ---- postconditions (FIX_VERIFY asks these; the fixes no longer do) --

run_case "predicate/always-enabled" 1 \
    '    [[ "$(auto_update_status)" == "ok" ]]' \
    '    true'

run_case "predicate/security-zero-still-pending" 1 \
    '    (( n <= 0 ))' \
    '    (( n < 0 ))'

run_case "predicate/failed-query-reads-none-pending" 1 \
    '    n=$(pkg_security_update_count) || return 1' \
    '    n=$(pkg_security_update_count) || return 0'

run_case "postcondition/install-status-discarded" 1 \
    '        _update_fix_enable_unattended || return 1' \
    '        _update_fix_enable_unattended || true'

# The snapshot moves after the install, where the postinst has already
# rewritten 20auto-upgrades.
run_case "install/snapshot-after-postinst" 1 \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '    :'

run_case "install/undo-not-recorded" 1 \
    '        (( ${#missing[@]} )) && record_undo update.install_unattended "$(pkg_remove_hint "${missing[@]}")"' \
    '        :'

run_case "apply/auto-enable-not-prevented" 1 \
    '        _update_uu_no_auto_enable' \
    '        :'

run_case "apply/auto-upgrades-not-recorded" 1 \
    '        backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '        :'

run_case "apply/undo-not-recorded" 1 \
    '        (( installed_uu )) && record_undo update.apply_security "apt purge unattended-upgrades"' \
    '        :'

run_case "apply/installed-check-inverted" 1 \
    '    if ! _update_unattended_installed; then' \
    '    if false; then'

run_case "apply/upgrade-failure-swallowed" 1 \
    '    APT_CONFIG="$cfg/apt.conf" unattended-upgrade -d 2>/dev/null || rc=$?' \
    '    APT_CONFIG="$cfg/apt.conf" unattended-upgrade -d 2>/dev/null || true'

run_case "apply/falls-back-to-full-upgrade" 1 \
    '    APT_CONFIG="$cfg/apt.conf" unattended-upgrade -d 2>/dev/null || rc=$?' \
    '    apt-get upgrade -y 2>/dev/null || rc=$?'

# ---- apply_security: the security origins only, for this one run ----------

# The original defect: unattended-upgrade on the operator's origins, which on
# Debian include the main archive's point releases.
run_case "apply/operator-origins" 1 \
    '    APT_CONFIG="$cfg/apt.conf" unattended-upgrade -d 2>/dev/null || rc=$?' \
    '    unattended-upgrade -d 2>/dev/null || rc=$?'

# APT_CONFIG is read BEFORE apt.conf.d, so its #clear is undone by 50's list;
# only as Dir::Etc::main is it read after.
run_case "apply/origins-read-first" 1 \
    "    } > \"\$dir/security.conf\" && printf 'Dir::Etc::main \"%s\";\\n' \"\$dir/security.conf\" > \"\$dir/apt.conf\"; then" \
    "    } > \"\$dir/security.conf\" && cp \"\$dir/security.conf\" \"\$dir/apt.conf\"; then"

run_case "apply/operator-apt-conf-dropped" 1 \
    "        [[ -f \"\$UPDATE_APT_MAIN_CONF\" ]] && printf '#include \"%s\";\\n' \"\$UPDATE_APT_MAIN_CONF\"" \
    '        :'

# Including a file that is not there is a syntax error that stops apt.
run_case "apply/missing-apt-conf-included" 1 \
    "        [[ -f \"\$UPDATE_APT_MAIN_CONF\" ]] && printf '#include \"%s\";\\n' \"\$UPDATE_APT_MAIN_CONF\"" \
    "        printf '#include \"%s\";\\n' \"\$UPDATE_APT_MAIN_CONF\""

run_case "apply/throwaway-config-left" 1 \
    '    rm -rf "$cfg"' \
    '    :'

run_case "apply/config-failure-ignored" 1 \
    '    cfg=$(_update_security_only_apt_config) || { print_error "$(i18n '"'"'update.updates_failed'"'"')"; return 1; }' \
    '    cfg=$(_update_security_only_apt_config) || true'

run_case "apply/history-hint-dropped" 1 \
    "        print_info \"\$(i18n 'update.security_applied_revert_hint')\"" \
    '        :'

# ---- the predicate the audit and the fix share -----------------------

run_case "predicate/private-status-copy-restored" 1 \
    '    [[ "$(auto_update_status)" == "ok" ]]' \
    '    systemctl is-enabled apt-daily-upgrade.timer &>/dev/null'

run_case "predicate/private-installed-copy-restored" 1 \
    '    auto_update_installed' \
    '    dpkg -l unattended-upgrades 2>/dev/null | grep -q "^ii"'

run_case "dispatch/unknown-id-succeeds" 1 \
    '            log_error "Unknown update fix: $fix_id"' \
    '            return 0'

# A swallowed backup failure lets the fix rewrite /etc with no way back.
run_case "rollback/backup-failure-swallowed" 2 \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null || return 1' \
    '    backup_file "$UPDATE_AUTO_UPGRADES_CONF" >/dev/null 2>&1 || true'

# install_unattended no longer refreshes the index: an empty apt cache cannot
# locate the package, which is how the fix failed on a fresh image.
run_case "install/no-refresh" 1 \
    '    apt_refresh_index' \
    '    :'

# apply_security installs unattended-upgrades without refreshing the index.
run_case "apply/no-refresh" 1 \
    '        apt_refresh_index' \
    '        :'

# The audit names the refresh timer as the reason, not a generic "not effective".
run_case "audit/refresh-reason-dropped" 1 \
    '            refresh_disabled)' \
    '            refresh_disabled_unmatched)'
