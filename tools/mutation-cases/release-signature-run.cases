# Mutation cases: tests/test_release_signature.bats against run.sh.
# mutate-suite: run.sh tests/test_release_signature.bats
#
# The suite loops over both entry points, so a mutation of run.sh's copy dies
# on the run.sh iteration while install.sh's copy keeps passing.

# One attempt only: a network blip refuses a good release again.
run_case "release-signature-run/no-retry" 1 \
    '    for attempt in 1 2 3; do' \
    '    for attempt in 1; do'

# The success exit is lost: a good release is re-checked until it is refused.
run_case "release-signature-run/success-not-returned" 1 \
    '            return 0' \
    '            :'

# Fails open: every attempt failed and the release is accepted anyway.
run_case "release-signature-run/fail-open" 1 \
    '    return 1' \
    '    return 0'

# cosign's error is discarded again, which is the defect this function fixes.
run_case "release-signature-run/stderr-dropped" 1 \
    '                "$archive" 2>&1 >/dev/null); then' \
    '                "$archive" >/dev/null 2>&1); then'

# cosign's stdout is captured with the error and can displace its last line.
run_case "release-signature-run/stdout-captured" 1 \
    '                "$archive" 2>&1 >/dev/null); then' \
    '                "$archive" 2>&1); then'

# All of stderr is quoted, including a TUF warning that is not the failure.
run_case "release-signature-run/whole-stderr-quoted" 1 \
    "    print_error \"  cosign: \${err##*\$'\\n'}\"" \
    '    print_error "  cosign: ${err}"'

# Retries run back to back, so a transient outage is still in progress.
run_case "release-signature-run/no-wait" 1 \
    '            sleep 5' \
    '            :'

# A wait follows the last attempt too, delaying the refusal for nothing.
run_case "release-signature-run/wait-after-last" 1 \
    '        if (( attempt < 3 )); then' \
    '        if true; then'

# The signer is pinned to a branch instead of the tag being run: a release built
# from any later push to main is accepted as this version.
run_case "release-signature-run/identity-not-the-tag" 1 \
    '        local want_identity="https://github.com/${VPSSEC_REPO}/.github/workflows/release.yml@refs/tags/${ver_tag}"' \
    '        local want_identity="https://github.com/${VPSSEC_REPO}/.github/workflows/release.yml@refs/heads/main"'

# The identity becomes a pattern that any workflow in any repository matches —
# the silent widening, since every real signature still verifies.
run_case "release-signature-run/identity-regexp" 1 \
    '                --certificate-identity "$identity" \' \
    "                --certificate-identity-regexp '.*' \\"

# Any OIDC issuer is accepted, so a certificate from another provider passes.
run_case "release-signature-run/issuer-regexp" 1 \
    '                --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" \' \
    "                --certificate-oidc-issuer-regexp '.*' \\"

# The pinned issuer itself changes.
run_case "release-signature-run/issuer-constant" 1 \
    'COSIGN_OIDC_ISSUER="https://token.actions.githubusercontent.com"' \
    'COSIGN_OIDC_ISSUER="https://accounts.google.com"'

# Transparency-log proof is no longer required for the signature.
run_case "release-signature-run/tlog-ignored" 1 \
    '                --bundle "$bundle" \' \
    '                --bundle "$bundle" --insecure-ignore-tlog \'

# The identity names another repository's workflow.
run_case "release-signature-run/repo-constant" 1 \
    'VPSSEC_REPO="Lynthar/CloudServer-Audit"' \
    'VPSSEC_REPO="someone-else/CloudServer-Audit"'

# A bare 1.2.0 is refused again, though install.sh takes it for the same tag.
run_case "release-signature-run/no-tag-normalise" 1 \
    '        [[ "$VPSSEC_VERSION" == v* ]] || VPSSEC_VERSION="v${VPSSEC_VERSION}"' \
    '        :'
