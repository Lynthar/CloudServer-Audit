# Mutation cases: tests/test_fix_ufw.bats against modules/ufw.sh.
# mutate-suite: modules/ufw.sh tests/test_fix_ufw.bats
#
# The occurrence index matters where the audit and the fix share a line verbatim;
# the rule and the rest of the runner's contract are in tools/mutate-suite.sh's header.

run_case "enable/allow-failure-ignored" 1 \
    '    if ! _ufw_allow_ssh_ports undo < <(_ufw_ssh_ports_unopened); then' \
    '    if false; then'

run_case "helper/allow-failure-ignored" 1 \
    '        if ! ufw allow "$p/tcp" comment "SSH (vpssec)" >/dev/null; then' \
    '        if false; then'

run_case "helper/undo-not-recorded" 1 \
    '        _undo+=("ufw delete allow $p/tcp")' \
    '        :'

run_case "enable/confirm-gate-removed" 1 \
    '    if ! confirm_critical "$(i18n '"'"'ufw.confirm_ufw_enable'"'"')"; then' \
    '    if false; then'

run_case "enable/decline-keeps-added-rules" 2 \
    '        _ufw_run_undo "${undo[@]}"' \
    '        :'

run_case "enable/rescue-rule-auto-deleted" 1 \
    '            print_warn "$(i18n '"'"'ufw.rescue_rule_kept'"'"' "ip=$current_ip")"' \
    '            ufw delete allow from "$current_ip"'

run_case "enable/rescue-rule-for-unknown-ip" 1 \
    '    if [[ -n "$current_ip" ]]; then' \
    '    if true; then'

run_case "enable/enable-failure-swallowed" 1 \
    '    if echo "y" | ufw enable >/dev/null; then' \
    '    if echo "y" | ufw enable >/dev/null || true; then'

run_case "enable/undo-not-recorded" 1 \
    '        record_undo ufw.enable "$(undo_join "ufw disable" "${undo[@]}")"' \
    '        :'

run_case "deny/allow-failure-ignored" 2 \
    '    if ! _ufw_allow_ssh_ports undo < <(_ufw_ssh_ports_unopened); then' \
    '    if false; then'

run_case "deny/ssh-rule-never-added" 1 \
    '        _ufw_admits_port "$port" open || echo "$port"' \
    '        :'

# Rules confined to an interface or a source would then count, and the policy
# flip would cut an operator connected over the public address.
run_case "deny/open-scope-dropped" 1 \
    '        _ufw_admits_port "$port" open || echo "$port"' \
    '        _ufw_admits_port "$port" || echo "$port"'

run_case "deny/idempotence-removed" 1 \
    '        _ufw_admits_port "$port" open || echo "$port"' \
    '        echo "$port"'

run_case "deny/outgoing-left-denied" 1 \
    '        ufw default allow outgoing >/dev/null 2>&1 || true' \
    '        :'

run_case "deny/undo-policy-dropped" 1 \
    '        [[ -n "$old_in" ]] && revert+=("ufw default ${old_in,,} incoming")' \
    '        :'

run_case "allow_ssh/coverage-ignored" 1 \
    '        _ufw_admits_port "$p" || missing+="$p"$'"'"'\n'"'"'' \
    '        missing+="$p"$'"'"'\n'"'"''

run_case "allow_ssh/only-last-port" 1 \
    '        _ufw_admits_port "$p" || missing+="$p"$'"'"'\n'"'"'' \
    '        _ufw_admits_port "$p" || missing="$p"$'"'"'\n'"'"''

run_case "allow_ssh/failure-swallowed" 1 \
    '    if ! _ufw_allow_ssh_ports undo <<<"$missing"; then' \
    '    if false; then'

run_case "allow_ssh/undo-not-recorded" 1 \
    '    record_undo ufw.allow_ssh "$(undo_join "${undo[@]}")"' \
    '    :'

run_case "install/failure-swallowed" 1 \
    '    if apt_install ufw; then' \
    '    if true; then'

# The index is no longer refreshed: an empty apt cache cannot locate ufw.
run_case "install/no-refresh" 1 \
    '    apt_refresh_index' \
    '    :'

run_case "install/undo-not-recorded" 1 \
    '        record_undo ufw.install "apt purge ufw"' \
    '        :'

run_case "dispatch/unknown-id-succeeds" 1 \
    '            log_error "Unknown UFW fix: $fix_id"' \
    '            return 0'

# A rescue rule that failed must not be announced as whitelisted: the operator
# confirms the enable on the strength of that line.
run_case "enable/rescue-failure-announced-as-done" 1 \
    "            tty_warn \"\$(i18n 'ufw.rescue_rule_failed' \"ip=\$current_ip\")\"" \
    "            print_info \"\$(i18n 'ufw.current_ip_whitelisted' \"ip=\$current_ip\")\""

# The failed rescue rule told only through print_*, which --json-only swallows:
# the operator confirms without knowing nothing but the port rules holds.
run_case "enable/rescue-failure-swallowed" 1 \
    "            tty_warn \"\$(i18n 'ufw.rescue_rule_failed' \"ip=\$current_ip\")\"" \
    "            print_warn \"\$(i18n 'ufw.rescue_rule_failed' \"ip=\$current_ip\")\""

# The confirmation screen: an inactive ufw's `status` lists no rules at all,
# so the operator confirms blind (it is only offered while ufw is inactive).
run_case "enable/confirm-screen-shows-status" 1 \
    '    LC_ALL=C ufw show added 2>/dev/null | head -20 | tty_out' \
    '    LC_ALL=C ufw status 2>/dev/null | head -20 | tty_out'

# The operator is not told that no rescue rule stands behind the confirmation.
run_case "enable/unknown-ip-unsaid" 1 \
    "        tty_warn \"\$(i18n 'ufw.operator_ip_unknown')\"" \
    '        :'

# ufw installed after kernel.harden_network ran: enabling it applies its stock
# sysctl file and the earlier fix comes undone, at once and at every boot.
run_case "enable/sysctl-not-aligned" 1 \
    '        _kernel_ufw_align_persisted && aligned=1' \
    '        aligned=1'

run_case "enable/sysctl-align-failure-unsaid" 1 \
    "    (( aligned )) || print_warn \"\$(i18n 'ufw.sysctl_not_aligned')\"" \
    '    :'
