# Mutation cases: tests/test_audit_host_claims.bats against modules/webapp.sh.
# mutate-suite: modules/webapp.sh tests/test_audit_host_claims.bats
#
# The defect: a caddy/openresty host was told it had no web server at all, as a
# PASSED check, and every web finding was skipped behind it.

# The candidate list is the whole detection.
run_case "claims/candidate-list-emptied" 1 \
    '    for candidate in caddy openresty lighttpd traefik haproxy; do' \
    '    for candidate in ; do'

# Dropping just the first entry is the shape a careless edit takes.
run_case "claims/caddy-dropped" 1 \
    '    for candidate in caddy openresty lighttpd traefik haproxy; do' \
    '    for candidate in openresty lighttpd traefik haproxy; do'

# The summary branch must choose the honest check; without it the audit is back
# to claiming the host serves nothing.
run_case "claims/summary-branch-skipped" 1 \
    '        if [[ -n "$other" ]]; then' \
    '        if false; then'

# Reverting to a bare `command -v` puts the answer back in the hands of
# whatever the runner has installed — the shape that made this suite pass in
# the verification container and fail on ubuntu-latest.
run_case "claims/bare-command-v-restored" 1 \
    '        if check_command "$candidate"; then found+=("$candidate"); fi' \
    '        command -v "$candidate" &>/dev/null && found+=("$candidate")'

# A web-roots-free host gets its scored sensitive-files pass back.
run_case "claims/no-root-still-passes" 1 \
    '    elif (( walked )) && [[ -n "$(_webapp_web_roots)" ]]; then' \
    '    elif (( walked )); then'

# A source-built nginx off PATH is reported as no web server again.
run_case "claims/nginx-off-path-unnamed" 1 \
    '    elif pgrep -x nginx >/dev/null 2>&1; then' \
    '    elif false; then'

# The Apache advice names a file again without asking which one sets it.
run_case "claims/apache-file-is-main-only" 1 \
    '        grep -qiE "^[^#]*$1[[:space:]]" "$f" 2>/dev/null && last="$f"' \
    '        :'

run_case "claims/apache-first-setter-wins" 1 \
    '        grep -qiE "^[^#]*$1[[:space:]]" "$f" 2>/dev/null && last="$f"' \
    '        [[ -z "$last" ]] && grep -qiE "^[^#]*$1[[:space:]]" "$f" 2>/dev/null && last="$f"'
