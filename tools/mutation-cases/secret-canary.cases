# Mutation cases: tests/test_secret_canary.bats against modules/malware.sh.
# mutate-suite: modules/malware.sh tests/test_secret_canary.bats
#
# STATED GAP: the suite names four modules and two are mutated against it, malware
# here and alerts in secret-canary-alerts.cases. scheduling's locations-only rule
# is mutated in cron-locations.cases against test_cron_spool.bats; filesystem's
# cron scan is exercised by this suite but not mutated.
#
# Process findings name the binary, never argv; crypto_miner is the one detector
# exempt by design. The hidden-process case is killed only where /proc exists:
# run it in the verification container, never on a macOS checkout.

run_case "argv/cpu-anomaly-reports-cmdline" 1 \
    '        findings+=("$pid|$cpu%|$exe")' \
    '        findings+=("$pid|$cpu%|$cmd")'

run_case "argv/hidden-process-reports-cmdline" 1 \
    '            [[ -n "$cmdline" ]] && hidden+=("$pid|$exe")' \
    '            [[ -n "$cmdline" ]] && hidden+=("$pid|$cmdline")'

# An LD_PRELOAD finding names file, line and the value: the rest of the line
# can be another assignment holding a password.
run_case "line/ld-preload-whole-line" 1 \
    '                shown="$file:$n: LD_PRELOAD=${value%%[[:space:];&|)]*}"' \
    '                shown="$file:$n: $line"'
