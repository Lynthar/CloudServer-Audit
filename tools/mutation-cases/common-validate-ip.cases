# Mutation cases: tests/test_validate.bats against core/common.sh.
# mutate-suite: core/common.sh tests/test_validate.bats
#
# validate_ip feeds ufw source scoping (the SSH rescue rule): junk must be
# rejected, not passed downstream.

# Drop the octet bound: 999.999.999.999 validates again.
run_case "validip/octet-bound-removed" 1 \
    "            (( 10#\$octet <= 255 )) || return 1" \
    "            (( 10#\$octet <= 999 )) || return 1"

# Accept any number of '::' again: \"::::\"-style soup validates.
run_case "validip/double-colon-uncounted" 1 \
    "        (( double_colons > 1 )) && return 1" \
    "        (( double_colons > 9 )) && return 1"

# Stop requiring 8 groups in uncompressed form: \"1:2:3:4:5:6:7\" passes.
run_case "validip/group-count-ignored" 1 \
    "            (( groups == 8 )) && return 0" \
    "            (( groups >= 1 )) && return 0"
