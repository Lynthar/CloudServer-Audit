# Mutation cases: tests/test_release_signature.bats against install.sh.
# mutate-suite: install.sh tests/test_release_signature.bats
#
# install.sh's copy of the function run.sh also carries (test_install_verify.bats
# keeps the two identical), so these are release-signature-run.cases' mutations
# and each one's reason is written there.

run_case "release-signature-install/no-retry" 1 \
    '    for attempt in 1 2 3; do' \
    '    for attempt in 1; do'

run_case "release-signature-install/success-not-returned" 1 \
    '            return 0' \
    '            :'

run_case "release-signature-install/fail-open" 1 \
    '    return 1' \
    '    return 0'

run_case "release-signature-install/stderr-dropped" 1 \
    '                "$archive" 2>&1 >/dev/null); then' \
    '                "$archive" >/dev/null 2>&1); then'

run_case "release-signature-install/stdout-captured" 1 \
    '                "$archive" 2>&1 >/dev/null); then' \
    '                "$archive" 2>&1); then'

run_case "release-signature-install/whole-stderr-quoted" 1 \
    "    print_error \"  cosign: \${err##*\$'\\n'}\"" \
    '    print_error "  cosign: ${err}"'

run_case "release-signature-install/no-wait" 1 \
    '            sleep 5' \
    '            :'

run_case "release-signature-install/wait-after-last" 1 \
    '        if (( attempt < 3 )); then' \
    '        if true; then'

run_case "release-signature-install/identity-not-the-tag" 1 \
    '        local want_identity="https://github.com/${GITHUB_REPO}/.github/workflows/release.yml@refs/tags/${ver_tag}"' \
    '        local want_identity="https://github.com/${GITHUB_REPO}/.github/workflows/release.yml@refs/heads/main"'

run_case "release-signature-install/identity-regexp" 1 \
    '                --certificate-identity "$identity" \' \
    "                --certificate-identity-regexp '.*' \\"

run_case "release-signature-install/issuer-regexp" 1 \
    '                --certificate-oidc-issuer "$COSIGN_OIDC_ISSUER" \' \
    "                --certificate-oidc-issuer-regexp '.*' \\"

run_case "release-signature-install/issuer-constant" 1 \
    'COSIGN_OIDC_ISSUER="https://token.actions.githubusercontent.com"' \
    'COSIGN_OIDC_ISSUER="https://accounts.google.com"'

run_case "release-signature-install/tlog-ignored" 1 \
    '                --bundle "$bundle" \' \
    '                --bundle "$bundle" --insecure-ignore-tlog \'

run_case "release-signature-install/repo-constant" 1 \
    'GITHUB_REPO="${GITHUB_REPO:-Lynthar/CloudServer-Audit}"' \
    'GITHUB_REPO="${GITHUB_REPO:-someone-else/CloudServer-Audit}"'
