# Mutation cases: tests/test_nginx_catchall_state.bats against modules/nginx.sh.
# mutate-suite: modules/nginx.sh tests/test_nginx_catchall_state.bats
#
# One of two files naming this module. This one pairs with the suite covering
# _nginx_catchall_coverage_from_text, the reading of a config into "<needed>
# <have>"; nginx.cases pairs with the fix and audit suite. Tokenizing (comments,
# quotes, includes) is core's nginx_statements, mutated in nginx-statements.cases.

# ---- what makes a server a catchall ---------------------------------------

# default_server is half the definition: a server answering 444 to the names it
# hosts is not a catchall for the names it does not.
run_case "parse/default-server-not-required" 1 \
    '            if (p == "80" && dflt) d80[$1] = 1' \
    '            if (p == "80") d80[$1] = 1'

run_case "parse/return-444-loosened" 1 \
    '        $3 == "return" && $4 ~ /^444( |$)/ { ret[$1] = 1 }' \
    '        $3 == "return" { ret[$1] = 1 }'

run_case "parse/port-80-substring-match" 1 \
    '            if (p == "80" && dflt) d80[$1] = 1' \
    '            if (p ~ /80/ && dflt) d80[$1] = 1'

run_case "parse/port-443-substring-match" 1 \
    '            if (p == "443") { on443[$1] = 1; if (dflt) d443[$1] = 1 }' \
    '            if (p ~ /443/) { on443[$1] = 1; if (dflt) d443[$1] = 1 }'

run_case "parse/reject-handshake-ignored" 1 \
    '        $3 == "ssl_reject_handshake" && $4 == "on" { rej[$1] = 1 }' \
    '        $3 == "ssl_reject_handshake" && $4 == "on" { }'

# ---- scope: one server's directives stay in that server --------------------

run_case "scope/return-444-shared-across-servers" 1 \
    '        $3 == "return" && $4 ~ /^444( |$)/ { ret[$1] = 1 }' \
    '        $3 == "return" && $4 ~ /^444( |$)/ { ret[1] = 1 }'

# ---- the answer ------------------------------------------------------------

run_case "state/both-satisfied-by-either-port" 1 \
    '            have = (c80 && c443) ? "both" : c80 ? "80only" : c443 ? "443only" : "none"' \
    '            have = (c80 || c443) ? "both" : c80 ? "80only" : c443 ? "443only" : "none"'

run_case "state/80only-mislabelled" 1 \
    '            have = (c80 && c443) ? "both" : c80 ? "80only" : c443 ? "443only" : "none"' \
    '            have = (c80 && c443) ? "both" : c80 ? "443only" : c443 ? "443only" : "none"'

# 443 is owed only where nginx serves it; a catchall alone on 443 is not serving.
run_case "needed/443-always-owed" 1 \
    '            print (serves ? "both" : "80") " " have' \
    '            print "both " have'

run_case "needed/catchall-counts-as-serving" 1 \
    '            for (s in on443) if (!((s in d443) && ((s in ret) || (s in rej)))) serves = 1' \
    '            for (s in on443) serves = 1'

run_case "needed/stream-counts-as-serving" 1 \
    '        $1 == 0 || $2 ~ /^(stream|mail)(\/|$)/ { next }' \
    '        $1 == 0 { next }'

run_case "covered/80-only-never-enough" 1 \
    '        "both both"|"80 both"|"80 80only") return 0 ;;' \
    '        "both both"|"80 both") return 0 ;;'

# ---- rivals and missing ports ----------------------------------------------

# A catchall counted as a rival: every covered host loses its fix offer.
run_case "rivals/catchall-80-counted" 1 \
    '                for (s in d80) if (!(s in ret)) print "80\t" name[s]' \
    '                for (s in d80) print "80\t" name[s]'

run_case "rivals/catchall-443-counted" 1 \
    '                for (s in d443) if (!((s in ret) || (s in rej))) print "443\t" name[s]' \
    '                for (s in d443) if (!(s in ret)) print "443\t" name[s]'

# A covered port written again is the duplicate default_server nginx rejects.
run_case "missing/covered-80-rewritten" 1 \
    '    [[ "$have" == 80only || "$have" == both ]] || ports="80"' \
    '    ports="80"'

run_case "missing/covered-443-rewritten" 1 \
    '    if [[ "$needed" == both && "$have" != 443only && "$have" != both ]]; then' \
    '    if [[ "$needed" == both ]]; then'
