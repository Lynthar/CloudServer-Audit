# Mutation cases: tests/test_webapp_nginx_scope.bats against modules/webapp.sh.
# mutate-suite: modules/webapp.sh tests/test_webapp_nginx_scope.bats
#
# The webapp nginx checks judge a value where it applies: per server, inherited
# from http{} when the server sets none, TLS checks only where TLS is served.

run_case "tls/gate-removed" 1 \
    '    [[ -n "$(_webapp_nginx_tls_servers)" ]] || return 0' \
    '    :'

run_case "tls/any-listen-is-tls" 1 \
    '        $3 == "listen" && (" " $4 " ") ~ / (ssl|quic) / { tls[$1] = 1 }' \
    '        $3 == "listen" { tls[$1] = 1 }'

run_case "tls/server-value-ignored" 1 \
    '                    if ((s, keys[d]) in own)               line = line "\t" own[s, keys[d]] "\tserver"' \
    '                    if (0)               line = line "\t" own[s, keys[d]] "\tserver"'

run_case "tls/http-value-not-inherited" 1 \
    '                    else if ((kind[s], keys[d]) in top)    line = line "\t" top[kind[s], keys[d]] "\t" kind[s]' \
    '                    else if (0)    line = line "\t" top[kind[s], keys[d]] "\t" kind[s]'

# The finding must say where an inherited value is set: that is the line to edit.
run_case "tls/inheritance-not-named" 1 \
    '    if [[ "$from" == server ]]; then' \
    '    if true; then'

# nginx's default is on: a server that sets nothing under an http{} that sets
# nothing sends its version.
run_case "tokens/default-read-as-off" 1 \
    '                v = (s in own) ? own[s] : (top != "" ? top : "on")' \
    '                v = (s in own) ? own[s] : (top != "" ? top : "off")'

# Presence is the binary, as for the nginx module; a config under /usr/local
# is still nginx.
run_case "presence/config-path-required" 1 \
    '    if nginx_present; then' \
    '    if [[ -f "$NGINX_CONF" ]] && nginx_present; then'

run_case "unreadable/graded-anyway" 1 \
    '        if nginx_dump_load; then' \
    '        if true; then'

run_case "sensitive/htaccess-back" 1 \
    '    ".env"' \
    '    ".env" ".htaccess"'

# ---- certificate expiry ------------------------------------------------------

# Only the scanned directories, CA certificates skipped: a self-signed
# certificate nginx serves is never checked, nor one kept anywhere else.
run_case "certs/served-not-checked" 1 \
    '    certs=(${served[@]+"${served[@]}"})' \
    '    certs=()'

# By path: Let's Encrypt's cert.pem and fullchain.pem were two certificates.
run_case "certs/checked-twice" 1 \
    '        [[ -n "$fp" && -z "${seen[$fp]:-}" ]] || continue' \
    '        [[ -n "$fp" ]] || continue'

run_case "certs/relative-path-unresolved" 1 \
    '        $3 == "ssl_certificate" && $4 !~ /[$]/ { print (($4 ~ /^\//) ? $4 : ENVIRON["CONF_DIR"] "/" $4) }' \
    '        $3 == "ssl_certificate" && $4 !~ /[$]/ { print $4 }'

# A config nginx rejects audited as complete: exit 0 over checks that never ran.
run_case "unreadable/audit-complete" 1 \
    '            _module_record_failure webapp query' \
    '            :'

# ---- security headers: requests to each site --------------------------------------

run_case "headers/v6-wildcard-asked-as-is" 1 \
    '                A = (a == "::") ? "::1" : a' \
    '                A = a'

run_case "headers/v4-wildcard-asked-as-is" 1 \
    '                A = (a == "*" || a == "localhost") ? "127.0.0.1" : a' \
    '                A = a'

run_case "headers/tls-not-preferred" 1 \
    '                    score = (tls ? 2 : 0) + (A ~ /:/ ? 1 : 2)' \
    '                    score = (A ~ /:/ ? 1 : 2)'

run_case "headers/v6-preferred" 1 \
    '                    score = (tls ? 2 : 0) + (A ~ /:/ ? 1 : 2)' \
    '                    score = (tls ? 2 : 0) + (A ~ /:/ ? 2 : 1)'

run_case "headers/implicit-default-ignored" 1 \
    '                    if (((bK in dflt) ? dflt[bK] : first[bK]) != s) { print "unchecked\t" label "\tname"; continue }' \
    '                    if (!(bK in dflt) || dflt[bK] != s) { print "unchecked\t" label "\tname"; continue }'

run_case "headers/explicit-default-ignored" 1 \
    '                    for (j = 2; j <= n; j++) if (w[j] == "default_server" || w[j] == "default") dflt[K] = s' \
    '                    j = n'

run_case "headers/reject-handshake-asked" 1 \
    '                if (!(s in seen) || (s in reject)) continue' \
    '                if (!(s in seen)) continue'

run_case "headers/stream-server-asked" 1 \
    '        $2 ~ /^http\/server(\/|$)/ { seen[$1] = 1; if ($1 > last) last = $1 }' \
    '        $2 ~ /server(\/|$)/ { seen[$1] = 1; if ($1 > last) last = $1 }'

# "_" is the conventional name that matches nothing; asked by it, nginx answers
# from the default server, so the finding would name the wrong site.
run_case "headers/catchall-name-asked" 1 \
    '                    if (name == "" && w[j] != "_" && w[j] !~ /^~/ && w[j] !~ /\*/) { name = w[j]; sub(/^\./, "", name) }' \
    '                    if (name == "") { name = w[j]; sub(/^\./, "", name) }'

run_case "headers/resolve-dropped" 1 \
    '    [[ "$2" == - ]] || opts+=(--resolve "$2")' \
    '    :'

run_case "headers/empty-reply-unchecked" 1 \
    '        (( rc != 52 )) || return 1' \
    '        :'

run_case "headers/redirect-judged" 1 \
    '        if [[ "$code" != 3[0-9][0-9] || -z "$location" ]]; then' \
    '        if true; then'

run_case "headers/same-origin-not-followed" 1 \
    '            url="$origin$location"' \
    '            return 1'

run_case "headers/redirect-elsewhere-followed" 1 \
    '        elif [[ "${location,,}" == "${origin,,}" || "${location,,}" == "${origin,,}"/* ]]; then' \
    '        elif true; then'

run_case "headers/one-hop-only" 1 \
    '        (( ++hops <= 3 )) || return 1' \
    '        (( ++hops <= 1 )) || return 1'

# HTTP/1.1 lines end in CRLF: a Location still carrying the CR names another URL.
run_case "headers/cr-kept" 1 \
    '            { sub(/\r$/, "") }' \
    '            { x = 1 }'

run_case "headers/name-case-sensitive" 1 \
    '            [[ ",$out," == *",${header,,},"* ]] || missing+=("$header")' \
    '            [[ ",$out," == *",${header},"* ]] || missing+=("$header")'

run_case "headers/budget-ignored" 1 \
    '        elif (( SECONDS >= deadline )); then' \
    '        elif false; then'

run_case "headers/ok-not-reported" 1 \
    '            ok) headers_ok=1 ;;' \
    '            ok) ;;'

run_case "headers/unchecked-not-reported" 1 \
    '    if (( ${#headers_unchecked[@]} > 0 )); then' \
    '    if false; then'

# nginx's reload returns before the new workers serve: one look can see the old.
run_case "headers/verify-not-retried" 1 \
    '        (( try == 3 )) || sleep 1' \
    '        break'

run_case "headers/verify-once" 1 \
    '    for try in 1 2 3; do' \
    '    for try in 1; do'

# A server with add_header of its own never inherits http{}'s: taken as reachable,
# the fix is offered there and every verify fails.
run_case "headers/own-add-header-unseen" 1 \
    '        $3 == "add_header" { own[$1] = 1 }' \
    '        $3 == "add_header" { }'

run_case "headers/own-reported-as-reachable" 1 \
    '            [[ "$own" == own ]] && kind=own' \
    '            :'

run_case "headers/fix-offered-out-of-reach" 1 \
    '            fix_id=""' \
    '            :'

# A verify in which no site answered saw no header go out.
run_case "headers/verify-passes-unseen" 1 \
    '            grep -q $'"'"'^ok\t'"'"' <<<"$results"' \
    '            true'
