# Mutation cases: tests/test_webapp_nginx_scope.bats against modules/webapp.sh.
# mutate-suite: modules/webapp.sh tests/test_webapp_nginx_scope.bats
#
# The webapp nginx checks judge a value where it applies: per server, inherited
# from http{} when the server sets none, TLS checks only where TLS is served.

run_case "tls/gate-removed" 1 \
    '    [[ -n "$(_webapp_nginx_tls_servers)" ]] || return 0' \
    '    :'

run_case "tls/any-listen-is-tls" 1 \
    '        $3 == "listen" && (" " $4 " ") ~ / (ssl|quic) / { tls[$1] = 1 }' \
    '        $3 == "listen" { tls[$1] = 1 }'

run_case "tls/server-value-ignored" 1 \
    '                    if ((s, keys[d]) in own)               line = line "\t" own[s, keys[d]] "\tserver"' \
    '                    if (0)               line = line "\t" own[s, keys[d]] "\tserver"'

run_case "tls/http-value-not-inherited" 1 \
    '                    else if ((kind[s], keys[d]) in top)    line = line "\t" top[kind[s], keys[d]] "\t" kind[s]' \
    '                    else if (0)    line = line "\t" top[kind[s], keys[d]] "\t" kind[s]'

# The finding must say where an inherited value is set: that is the line to edit.
run_case "tls/inheritance-not-named" 1 \
    '    if [[ "$from" == server ]]; then' \
    '    if true; then'

# nginx's default is on: a server that sets nothing under an http{} that sets
# nothing sends its version.
run_case "tokens/default-read-as-off" 1 \
    '                v = (s in own) ? own[s] : (top != "" ? top : "on")' \
    '                v = (s in own) ? own[s] : (top != "" ? top : "off")'

# Presence is the binary, as for the nginx module; a config under /usr/local
# is still nginx.
run_case "presence/config-path-required" 1 \
    '    if nginx_present; then' \
    '    if [[ -f "$NGINX_CONF" ]] && nginx_present; then'

run_case "unreadable/graded-anyway" 1 \
    '        if nginx_dump_load; then' \
    '        if true; then'

run_case "sensitive/htaccess-back" 1 \
    '    ".env"' \
    '    ".env" ".htaccess"'
