# Mutation cases: tests/test_fix_nginx_catchall.bats against modules/nginx.sh.
# mutate-suite: modules/nginx.sh tests/test_fix_nginx_catchall.bats
#
# ONE of three files naming this module — nginx-state.cases and nginx-fallback.cases
# pair with the two audit-side suites.
#
# The path cases are pinned through READ-ONLY call sites — backup_file, the -d/-f
# guards — never through write_file_atomic, `openssl -out` or `mkdir -p`. The
# verification container has a real /etc/nginx, so inlining a literal on a write
# would rewrite the container's own config and leave every later case running
# against a changed host.

# ---- the path variables that make the fix testable at all ------------------
# The certificate paths were /etc/nginx/ssl literals, including two inside the
# config heredoc. Re-hardcoding any of them silently removes the fix from coverage
# while the suite stays green, so each gets its own case.

run_case "paths/conf-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null || return 1' \
    '    backup_file /etc/nginx/sites-enabled/99-catchall.conf >/dev/null || return 1'

run_case "paths/cert-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_CERT" >/dev/null || return 1' \
    '    backup_file /etc/nginx/ssl/default.crt >/dev/null || return 1'

run_case "paths/key-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_KEY" >/dev/null || return 1' \
    '    backup_file /etc/nginx/ssl/default.key >/dev/null || return 1'

run_case "paths/sites-enabled-inlined" 1 \
    '    if [[ ! -d "$NGINX_SITES_ENABLED" ]]; then' \
    '    if [[ ! -d /etc/nginx/sites-enabled ]]; then'

run_case "paths/cert-guard-inlined" 1 \
    '    [[ -f "$NGINX_CATCHALL_CERT" ]] && return 0' \
    '    [[ -f /etc/nginx/ssl/default.crt ]] && return 0'

run_case "paths/heredoc-cert-inlined" 1 \
    '    ssl_certificate ${NGINX_CATCHALL_CERT};' \
    '    ssl_certificate /etc/nginx/ssl/default.crt;'

run_case "paths/heredoc-key-inlined" 1 \
    '    ssl_certificate_key ${NGINX_CATCHALL_KEY};' \
    '    ssl_certificate_key /etc/nginx/ssl/default.key;'

# ---- the rollback contract -------------------------------------------------
# The module called backup_file zero times, so the config, the certificate and the
# key were all invisible to `vpssec rollback`. The guarded variants model the
# recurring `[[ -f ]] && backup_file` defect: on a first run none of these files
# exist, which is precisely when .vpssec_created has to record them.

run_case "rollback/conf-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null || return 1' \
    '    :'

run_case "rollback/conf-backup-guarded" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null || return 1' \
    '    [[ -f "$NGINX_CATCHALL_CONF" ]] && { backup_file "$NGINX_CATCHALL_CONF" >/dev/null || return 1; }'

run_case "rollback/cert-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_CERT" >/dev/null || return 1' \
    '    :'

run_case "rollback/key-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_KEY" >/dev/null || return 1' \
    '    :'

# ---- the silent skip that reported success ---------------------------------
# Without the sites-enabled check the catchall is written where nothing reads it:
# nginx -t passes, the reload succeeds and the fix returns 0 while the catchall is
# not live and the next audit still reports it missing.

run_case "skip/sites-enabled-check-removed" 1 \
    '    if [[ ! -d "$NGINX_SITES_ENABLED" ]]; then' \
    '    if false; then'

run_case "skip/include-hint-not-printed" 1 \
    '        print_info "$(i18n '"'"'nginx.sites_enabled_hint'"'"' "dir=$NGINX_SITES_ENABLED")"' \
    '        :'

# ---- the four discarded statuses -------------------------------------------
# errexit is OFF inside a fix (execute_fix calls it in a condition context), so none
# of these aborted anything on their own. Each case breaks only the STATUS CHECK,
# never the action: `if ! cmd && false` still runs cmd and ignores its result, which
# is the defect; `if false` would delete the action itself. The openssl command
# spans four lines, so it is broken at the CLOSING line.

run_case "status/config-write-unchecked" 1 \
    '    if ! write_file_atomic "$NGINX_CATCHALL_CONF" "$(_nginx_catchall_config)"; then' \
    '    if ! write_file_atomic "$NGINX_CATCHALL_CONF" "$(_nginx_catchall_config)" && false; then'

run_case "status/ssl-mkdir-unchecked" 1 \
    '    if ! mkdir -p "$NGINX_SSL_DIR" 2>/dev/null; then' \
    '    if ! mkdir -p "$NGINX_SSL_DIR" 2>/dev/null && false; then'

run_case "status/openssl-unchecked" 1 \
    '            -subj "/CN=invalid" 2>/dev/null; then' \
    '            -subj "/CN=invalid" 2>/dev/null && false; then'

run_case "status/key-chmod-unchecked" 1 \
    '    if ! chmod 600 "$NGINX_CATCHALL_KEY" 2>/dev/null; then' \
    '    if ! chmod 600 "$NGINX_CATCHALL_KEY" 2>/dev/null && false; then'

run_case "status/nginx-test-unchecked" 1 \
    '    if ! test_output=$(_nginx_test_config); then' \
    '    if ! test_output=$(_nginx_test_config) && false; then'

# Without nginx's own message the operator is told "configuration test failed" and
# nothing else — no file, no line. On a stock Debian host that is the outcome every
# time, because the distro's default site already claims default_server on port 80.
run_case "status/nginx-message-swallowed" 1 \
    '        [[ -n "$test_output" ]] && print_info "$(i18n '"'"'nginx.nginx_test_output'"'"' "msg=$test_output")"' \
    '        :'

run_case "status/nginx-stderr-discarded" 1 \
    '    nginx -t 2>&1' \
    '    nginx -t 2>/dev/null'

run_case "status/reload-unchecked" 1 \
    '    if ! systemctl reload nginx 2>/dev/null; then' \
    '    if ! systemctl reload nginx 2>/dev/null && false; then'

# ---- validation-failure cleanup: undo this run, and only this run ----------
# The old cleanup deleted the config unconditionally, so a validation failure caused
# by something else entirely took the operator's own 99-catchall.conf with it.

run_case "cleanup/deletes-operator-file" 1 \
    '        if (( conf_existed )); then' \
    '        if false; then'

run_case "cleanup/conf-existed-never-set" 1 \
    '    [[ -e "$NGINX_CATCHALL_CONF" ]] && conf_existed=1' \
    '    :'

# A dangling link at the path (what a rollback of the old symlink layout left)
# is kept as if it were the operator's file, so nginx -t goes on failing.
run_case "cleanup/dangling-link-kept" 1 \
    '    [[ -e "$NGINX_CATCHALL_CONF" ]] && conf_existed=1' \
    '    [[ -e "$NGINX_CATCHALL_CONF" || -L "$NGINX_CATCHALL_CONF" ]] && conf_existed=1'

# ---- the postcondition -----------------------------------------------------
# nginx -t passing says the config PARSES and the reload says it was loaded. Neither
# says this host now has a catchall: an nginx.conf that includes only conf.d/, or a
# competing default_server, leaves the answer where it was.

run_case "postcondition/removed" 1 \
    '    if [[ "$state" != "both" ]]; then' \
    '    if false; then'

run_case "postcondition/accepts-partial-coverage" 1 \
    '    if [[ "$state" != "both" ]]; then' \
    '    if [[ "$state" == "none" ]]; then'

# A swallowed backup failure lets the fix rewrite /etc with no way back.
run_case "rollback/backup-failure-swallowed" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null || return 1' \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null 2>&1 || true'
