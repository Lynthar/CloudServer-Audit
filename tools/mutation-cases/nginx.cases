# Mutation cases for tests/test_fix_nginx_catchall.bats against modules/nginx.sh.
# mutate-suite: modules/nginx.sh tests/test_fix_nginx_catchall.bats
#
# Run with:
#   bash tools/mutate-suite.sh modules/nginx.sh \
#        tests/test_fix_nginx_catchall.bats tools/mutation-cases/nginx.cases
#
# This is ONE of three files naming this module — nginx-state.cases and
# nginx-fallback.cases pair with the two audit-side suites. A cases file is
# paired with exactly one suite: a case aimed at code the suite does not cover
# reads as a coverage gap that is not one, and the reverse (a suite with no
# cases file at all) is how three unasserting logrotate tests once shipped.
#
# The path cases are pinned through READ-ONLY call sites — backup_file, the
# -d/-f guards — never through write_file_atomic, `openssl -out`, `mkdir -p` or
# `ln`. The verification container has a real /etc/nginx, so inlining a literal
# on a write would rewrite the container's own config and leave every later
# case running against a changed host.

# ---- the path variables that make the fix testable at all ------------------
#
# The certificate paths were /etc/nginx/ssl literals, including two inside the
# config heredoc. Re-hardcoding any of them silently removes the fix from
# coverage while the suite stays green, so each gets its own case.

run_case "paths/conf-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null 2>&1 || true' \
    '    backup_file /etc/nginx/sites-available/99-catchall.conf >/dev/null 2>&1 || true'

run_case "paths/cert-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_CERT" >/dev/null 2>&1 || true' \
    '    backup_file /etc/nginx/ssl/default.crt >/dev/null 2>&1 || true'

run_case "paths/key-inlined" 1 \
    '    backup_file "$NGINX_CATCHALL_KEY" >/dev/null 2>&1 || true' \
    '    backup_file /etc/nginx/ssl/default.key >/dev/null 2>&1 || true'

run_case "paths/sites-enabled-inlined" 1 \
    '    if [[ ! -d "$NGINX_SITES_ENABLED" ]]; then' \
    '    if [[ ! -d /etc/nginx/sites-enabled ]]; then'

run_case "paths/cert-guard-inlined" 1 \
    '    [[ -f "$NGINX_CATCHALL_CERT" ]] && return 0' \
    '    [[ -f /etc/nginx/ssl/default.crt ]] && return 0'

run_case "paths/heredoc-cert-inlined" 1 \
    '    ssl_certificate ${NGINX_CATCHALL_CERT};' \
    '    ssl_certificate /etc/nginx/ssl/default.crt;'

run_case "paths/heredoc-key-inlined" 1 \
    '    ssl_certificate_key ${NGINX_CATCHALL_KEY};' \
    '    ssl_certificate_key /etc/nginx/ssl/default.key;'

# ---- the rollback contract -------------------------------------------------
#
# The module called backup_file zero times, so the config, the certificate and
# the key were all invisible to `vpssec rollback`. The guarded variants model
# the recurring `[[ -f ]] && backup_file` defect: on a first run none of these
# files exist, which is precisely when .vpssec_created has to record them.

run_case "rollback/conf-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null 2>&1 || true' \
    '    :'

run_case "rollback/conf-backup-guarded" 1 \
    '    backup_file "$NGINX_CATCHALL_CONF" >/dev/null 2>&1 || true' \
    '    [[ -f "$NGINX_CATCHALL_CONF" ]] && backup_file "$NGINX_CATCHALL_CONF" >/dev/null 2>&1 || true'

run_case "rollback/cert-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_CERT" >/dev/null 2>&1 || true' \
    '    :'

run_case "rollback/key-backup-skipped" 1 \
    '    backup_file "$NGINX_CATCHALL_KEY" >/dev/null 2>&1 || true' \
    '    :'

# Registering the symlink is worse than not registering it: backup_restore
# skips a created path that is a symlink and counts it as *skipped*, so the
# link survives the rollback anyway AND the return goes from 0 to 2. The
# backup_file lands BEFORE the ln so the path is still absent and therefore
# recorded in .vpssec_created — registering it after the link exists would
# snapshot content instead and model a different bug.
run_case "rollback/symlink-registered" 1 \
    '    if ! ln -sfn "$NGINX_CATCHALL_CONF" "$NGINX_CATCHALL_LINK" 2>/dev/null; then' \
    '    backup_file "$NGINX_CATCHALL_LINK" >/dev/null 2>&1 || true; if ! ln -sfn "$NGINX_CATCHALL_CONF" "$NGINX_CATCHALL_LINK" 2>/dev/null; then'

# The printed line and the logged line are separate assertions on purpose: a
# printed line scrolls away, and this one may be wanted days later.
run_case "rollback/symlink-revert-not-printed" 1 \
    '    print_info "$(i18n '"'"'nginx.symlink_revert_hint'"'"' "cmd=$revert")"' \
    '    :'

run_case "rollback/symlink-revert-not-logged" 1 \
    '    log_info "nginx.add_catchall revert command: $revert"' \
    '    :'

# ---- the silent skip that reported success ---------------------------------
#
# `ln -sf` used to sit under `[[ -d sites-enabled ]]`. With the directory
# absent the link was skipped, nginx -t passed (nothing new was included), the
# reload succeeded, two print_ok's fired and the fix returned 0 — while the
# catchall was not live and the next audit still reported it missing.

run_case "skip/sites-enabled-check-removed" 1 \
    '    if [[ ! -d "$NGINX_SITES_ENABLED" ]]; then' \
    '    if false; then'

run_case "skip/include-hint-not-printed" 1 \
    '        print_info "$(i18n '"'"'nginx.sites_enabled_hint'"'"' "dir=$NGINX_SITES_ENABLED")"' \
    '        :'

# ---- the four discarded statuses -------------------------------------------
#
# errexit is OFF inside a fix (execute_fix calls it in a condition context), so
# none of these aborted anything on their own. Each case breaks only the STATUS
# CHECK, never the action: `if ! cmd && false` still runs cmd and ignores its
# result, which is the defect. `if false` would delete the action itself — a
# different and much louder bug. The openssl command spans four lines, so it is
# broken at the CLOSING line.

run_case "status/config-write-unchecked" 1 \
    '    if ! write_file_atomic "$NGINX_CATCHALL_CONF" "$(_nginx_catchall_config)"; then' \
    '    if ! write_file_atomic "$NGINX_CATCHALL_CONF" "$(_nginx_catchall_config)" && false; then'

run_case "status/ssl-mkdir-unchecked" 1 \
    '    if ! mkdir -p "$NGINX_SSL_DIR" 2>/dev/null; then' \
    '    if ! mkdir -p "$NGINX_SSL_DIR" 2>/dev/null && false; then'

run_case "status/openssl-unchecked" 1 \
    '            -subj "/CN=invalid" 2>/dev/null; then' \
    '            -subj "/CN=invalid" 2>/dev/null && false; then'

run_case "status/key-chmod-unchecked" 1 \
    '    if ! chmod 600 "$NGINX_CATCHALL_KEY" 2>/dev/null; then' \
    '    if ! chmod 600 "$NGINX_CATCHALL_KEY" 2>/dev/null && false; then'

run_case "status/symlink-unchecked" 1 \
    '    if ! ln -sfn "$NGINX_CATCHALL_CONF" "$NGINX_CATCHALL_LINK" 2>/dev/null; then' \
    '    if ! ln -sfn "$NGINX_CATCHALL_CONF" "$NGINX_CATCHALL_LINK" 2>/dev/null && false; then'

run_case "status/nginx-test-unchecked" 1 \
    '    if ! test_output=$(_nginx_test_config); then' \
    '    if ! test_output=$(_nginx_test_config) && false; then'

# Without nginx's own message the operator is told "configuration test failed"
# and nothing else — no file, no line. On a stock Debian host that is the
# outcome every time, because the distro's default site already claims
# default_server on port 80.
run_case "status/nginx-message-swallowed" 1 \
    '        [[ -n "$test_output" ]] && print_info "$(i18n '"'"'nginx.nginx_test_output'"'"' "msg=$test_output")"' \
    '        :'

run_case "status/nginx-stderr-discarded" 1 \
    '    nginx -t 2>&1' \
    '    nginx -t 2>/dev/null'

run_case "status/reload-unchecked" 1 \
    '    if ! systemctl reload nginx 2>/dev/null; then' \
    '    if ! systemctl reload nginx 2>/dev/null && false; then'

# ---- validation-failure cleanup: undo this run, and only this run ----------
#
# The old cleanup deleted the config unconditionally, so a validation failure
# caused by something else entirely took the operator's own 99-catchall.conf
# with it.

run_case "cleanup/deletes-operator-file" 1 \
    '        if (( conf_existed )); then' \
    '        if false; then'

run_case "cleanup/conf-existed-never-set" 1 \
    '    [[ -e "$NGINX_CATCHALL_CONF" ]] && conf_existed=1' \
    '    :'

# -e follows the symlink, so a dangling link at that path reads as absent and
# the cleanup deletes something this run did not create. The same trap made the
# suite's own "leaves nothing behind" assertion pass with the removal deleted —
# it asserted `! -e link` while the cleanup had just removed the link's target,
# so the link was dangling and the assertion held either way.
run_case "cleanup/dangling-link-reads-as-absent" 1 \
    '    [[ -L "$NGINX_CATCHALL_LINK" || -e "$NGINX_CATCHALL_LINK" ]] && link_existed=1' \
    '    [[ -e "$NGINX_CATCHALL_LINK" ]] && link_existed=1'

run_case "cleanup/link-not-removed" 1 \
    '        (( link_existed )) || rm -f "$NGINX_CATCHALL_LINK"' \
    '        :'

# ---- the postcondition -----------------------------------------------------
#
# nginx -t passing says the config PARSES and the reload says it was loaded.
# Neither says this host now has a catchall: a nginx.conf that includes only
# conf.d/, or a competing default_server, leaves the answer where it was.

run_case "postcondition/removed" 1 \
    '    if [[ "$state" != "both" ]]; then' \
    '    if false; then'

run_case "postcondition/accepts-partial-coverage" 1 \
    '    if [[ "$state" != "both" ]]; then' \
    '    if [[ "$state" == "none" ]]; then'
