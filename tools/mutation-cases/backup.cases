# Mutation cases for tests/test_fix_backup.bats against modules/backup.sh.
#
# Run with:
#   bash tools/mutate-suite.sh modules/backup.sh \
#        tests/test_fix_backup.bats tools/mutation-cases/backup.cases
#
# PAIRING WARNING, and the reason this header is longer than most. `ls
# tests/*backup*.bats` matches three files, and only ONE of them is about this
# module: test_backup_restore.bats and test_backup_mode_restore.bats cover
# core's rollback contract (backup_file / backup_restore in core/common.sh and
# core/state.sh) and never source modules/backup.sh at all. The per-suite
# coverage check was built to catch a MISSING cases file; a name collision
# makes it report suites that do not exist. Check what a matched suite sources,
# not just that it matched — the core ones are covered by common.cases and
# state.cases.
#
# Every anchor below is unique in the file (grep -cxF == 1), so the occurrence
# index is 1 throughout.
#
# This module writes only into vpssec's own templates tree, so no mutation here
# can redirect a write at the container's real /etc.

# ---- the fix's own status --------------------------------------------------
#
# Before this batch _backup_fix_generate_templates called three generators,
# discarded all three statuses and ended `return 0`. errexit is off inside a
# fix (execute_fix invokes it in a condition context), so nothing else would
# have stopped it either — the operator got "Backup templates generated in:
# ..." and the engine recorded the fix complete, over an empty directory.

run_case "fix/templates-dir-status-discarded" 1 \
    '    if ! mkdir -p "$BACKUP_TEMPLATES_DIR"; then' \
    '    if ! mkdir -p "$BACKUP_TEMPLATES_DIR" && false; then'

# One case per generator. The first is killed by any write-failure test; the
# second and third need the tests that let the earlier generators succeed,
# which is exactly the shape a "check only the first one" implementation
# passes.
run_case "fix/restic-status-discarded" 1 \
    '    _backup_generate_restic_template || return 1' \
    '    _backup_generate_restic_template || true'

run_case "fix/borg-status-discarded" 1 \
    '    _backup_generate_borg_template || return 1' \
    '    _backup_generate_borg_template || true'

run_case "fix/systemd-status-discarded" 1 \
    '    _backup_generate_systemd_template || return 1' \
    '    _backup_generate_systemd_template || true'

# ---- the shared writer -----------------------------------------------------

run_case "writer/write-status-discarded" 1 \
    '    if ! cat > "$path"; then' \
    '    if ! cat > "$path" && false; then'

run_case "writer/chmod-status-discarded" 1 \
    '    if [[ -n "$mode" ]] && ! chmod "$mode" "$path"; then' \
    '    if [[ -n "$mode" ]] && ! chmod "$mode" "$path" && false; then'

# ---- the modes -------------------------------------------------------------
#
# 700 rather than +x is deliberate: both scripts carry a repository URL and,
# once the operator fills them in, cloud credentials. `chmod +x` yields 755
# under the usual umask, i.e. world-readable.

run_case "modes/restic-world-readable" 1 \
    "    _backup_write_template restic-backup.sh 700 <<'EOF' || return 1" \
    "    _backup_write_template restic-backup.sh +x <<'EOF' || return 1"

run_case "modes/borg-world-readable" 1 \
    "    _backup_write_template borg-backup.sh 700 <<'EOF' || return 1" \
    "    _backup_write_template borg-backup.sh +x <<'EOF' || return 1"

# The unit files and the README are data, not programs; handing them an
# executable bit is the opposite mistake and just as wrong.
run_case "modes/unit-file-executable" 1 \
    "    _backup_write_template backup.service <<'EOF' || return 1" \
    "    _backup_write_template backup.service 700 <<'EOF' || return 1"

# ---- the individual writes -------------------------------------------------
#
# Each generator writes one to three artifacts, and every one of those needs
# its own `|| return 1` — the systemd generator's three are the case that
# motivated the "timer" and "README" tests in the paired suite.

run_case "writes/restic-unchecked" 1 \
    "    _backup_write_template restic-backup.sh 700 <<'EOF' || return 1" \
    "    _backup_write_template restic-backup.sh 700 <<'EOF' || true"

run_case "writes/borg-unchecked" 1 \
    "    _backup_write_template borg-backup.sh 700 <<'EOF' || return 1" \
    "    _backup_write_template borg-backup.sh 700 <<'EOF' || true"

run_case "writes/service-unchecked" 1 \
    "    _backup_write_template backup.service <<'EOF' || return 1" \
    "    _backup_write_template backup.service <<'EOF' || true"

run_case "writes/timer-unchecked" 1 \
    "    _backup_write_template backup.timer <<'EOF' || return 1" \
    "    _backup_write_template backup.timer <<'EOF' || true"

run_case "writes/readme-unchecked" 1 \
    "    _backup_write_template README.md <<'EOF' || return 1" \
    "    _backup_write_template README.md <<'EOF' || true"

# ---- the generated content -------------------------------------------------

# An inline RESTIC_PASSWORD leaks with the file the moment it loses its 700
# mode; the template uses a password FILE and explains why in a comment.
run_case "content/restic-inline-password" 1 \
    'export RESTIC_PASSWORD_FILE="/root/.restic-password"' \
    'export RESTIC_PASSWORD="your-passphrase"'

# ---- what the report claims ------------------------------------------------

# The check is hardcoded `passed` and only asks which of five directories
# exist; it never reads the backup tool's config or excludes. The desc now
# says so. Pointing it back at a key without the disclaimer restores a green
# line the operator can disprove — the one defect family with no other
# automated gate (i18n parity only checks that keys exist, bats only checks
# which branch ran).
run_case "report/paths-claim-unqualified" 1 \
    "        \"\$(i18n 'backup.paths_list' \"paths=\$paths_list\")\" \\" \
    "        \"\$(i18n 'backup.critical_paths' \"paths=\$paths_list\")\" \\"

# ---- the dispatcher --------------------------------------------------------

run_case "dispatch/unknown-fix-succeeds" 1 \
    '            return 1' \
    '            return 0'
