# Mutation cases: tests/test_nginx_catchall_fallback.bats against modules/nginx.sh.
# mutate-suite: modules/nginx.sh tests/test_nginx_catchall_fallback.bats
#
# One of three files naming this module: nginx.cases pairs with the fix suite,
# nginx-state.cases with the `nginx -T` parser, this one with the file-scan fallback
# used when nginx -T is unavailable. That fallback is a SECOND, independent
# implementation of the same question — file-level rather than block-level — so the
# state parser's cases say nothing about it.
#
# The one path case is pinned through the grep that READS NGINX_CONF_DIR. The
# verification container has a real /etc/nginx, and this scan only reads it.

# ---- the fallback has to be the thing that runs ----------------------------

# With the primary branch always taken, _nginx_catchall_state_from_text gets
# the empty dump the stubbed `nginx -T` produces and answers "none" for
# everything.
run_case "reach/fallback-unreachable" 1 \
    '    if effective=$(nginx -T 2>/dev/null) && [[ -n "$effective" ]]; then' \
    '    if true; then'

run_case "paths/conf-dir-inlined" 1 \
    '    done < <(grep -rlE "listen.*default_server" "$NGINX_CONF_DIR" 2>/dev/null)' \
    '    done < <(grep -rlE "listen.*default_server" /etc/nginx 2>/dev/null)'

# The H18 regression in its modern form: the original chained grep through
# `head -1`, so only one file was ever probed and catchalls split across two
# files read as partial coverage.
run_case "scan/only-first-file-probed" 1 \
    '    done < <(grep -rlE "listen.*default_server" "$NGINX_CONF_DIR" 2>/dev/null)' \
    '    done < <(grep -rlE "listen.*default_server" "$NGINX_CONF_DIR" 2>/dev/null | head -1)'

# ---- what makes a file count ----------------------------------------------

# Without the `return 444` requirement any default_server vhost reads as a
# catchall — which is most of what a real nginx config contains.
run_case "scan/return-444-not-required" 1 \
    '        grep -qE "^[[:space:]]*return[[:space:]]+444[[:space:]]*;" "$f" 2>/dev/null || continue' \
    '        :'

# default_server is the other half, per port. The 443 case had no test until
# this file was written.
run_case "scan/port-80-default-server-not-required" 1 \
    '        grep -qE "listen[^;]*(:80([[:space:]]|;)|[[:space:]]80([[:space:]]|;))[^;]*default_server" "$f" 2>/dev/null && found_80=1' \
    '        grep -qE "listen[^;]*(:80([[:space:]]|;)|[[:space:]]80([[:space:]]|;))" "$f" 2>/dev/null && found_80=1'

run_case "scan/port-443-default-server-not-required" 1 \
    '        grep -qE "listen[^;]*(:443([[:space:]]|;)|[[:space:]]443([[:space:]]|;))[^;]*default_server" "$f" 2>/dev/null && found_443=1' \
    '        grep -qE "listen[^;]*(:443([[:space:]]|;)|[[:space:]]443([[:space:]]|;))" "$f" 2>/dev/null && found_443=1'

# ---- port boundaries -------------------------------------------------------
# A separate regex from the parser's, so it needs its own pinning: 8080 must not
# read as 80 and 4430 must not read as 443.

run_case "scan/port-80-substring-match" 1 \
    '        grep -qE "listen[^;]*(:80([[:space:]]|;)|[[:space:]]80([[:space:]]|;))[^;]*default_server" "$f" 2>/dev/null && found_80=1' \
    '        grep -qE "listen[^;]*80[^;]*default_server" "$f" 2>/dev/null && found_80=1'

run_case "scan/port-443-substring-match" 1 \
    '        grep -qE "listen[^;]*(:443([[:space:]]|;)|[[:space:]]443([[:space:]]|;))[^;]*default_server" "$f" 2>/dev/null && found_443=1' \
    '        grep -qE "listen[^;]*443[^;]*default_server" "$f" 2>/dev/null && found_443=1'

# ---- what the four states mean ---------------------------------------------

run_case "state/both-satisfied-by-either-port" 1 \
    '    if   [[ $found_80 -eq 1 && $found_443 -eq 1 ]]; then echo "both"' \
    '    if   [[ $found_80 -eq 1 || $found_443 -eq 1 ]]; then echo "both"'
