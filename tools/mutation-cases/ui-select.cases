# Mutation cases: tests/test_guide_plan_contract.bats against core/ui_tui.sh.
# mutate-suite: core/ui_tui.sh tests/test_guide_plan_contract.bats
#
# The regression: the TUI checklist tagged rows with the CHECK id while generate_plan
# resolves by FIX id, so every TUI-mode guide run executed an empty plan and printed
# success.

# Re-introduce it: tag with .id again.
run_case "tuiselect/check-id-tag" 1 \
    "        local fix_id=\$(echo \"\$fix\" | jq -r '.fix_id')" \
    "        local fix_id=\$(echo \"\$fix\" | jq -r '.id')"

# Drop the dedup: two checks sharing one fix produce duplicate checklist
# tags (whiptail rejects those outright).
run_case "tuiselect/dedup-removed" 1 \
    "        [[ -n \"\${seen[\$fix_id]:-}\" ]] && continue" \
    "        :"

# Every row ticked again: a bare Enter plans the risky fixes too.
run_case "tuiselect/all-preticked" 1 \
    '        local state="off"' \
    '        local state="on"'

# Ticked by the wrong class.
run_case "tuiselect/preticks-non-safe" 1 \
    "        [[ \"\$(echo \"\$fix\" | jq -r '.safety // \"\"')\" == \"safe\" ]] && state=\"on\"" \
    "        [[ \"\$(echo \"\$fix\" | jq -r '.safety // \"\"')\" != \"safe\" ]] && state=\"on\""

# ---- layout: newt counts code points, a CJK cell is two -----------------------

run_case "tuiselect/text-not-truncated" 1 \
    '        items+=("${ids[$i]}" "$(truncate_to_width "${texts[$i]}" $(( TUI_WIDTH - 13 - tag_w )))" "${states[$i]}")' \
    '        items+=("${ids[$i]}" "${texts[$i]}" "${states[$i]}")'

run_case "tuiselect/tag-column-ignored" 1 \
    '        if (( ${#id} > tag_w )); then tag_w=${#id}; fi' \
    '        :'

# --scrolltext on a plan that fits: every text row loses the right border.
run_case "textbox/always-scrolls" 1 \
    '        (( $(wc -l < "$view") > TUI_HEIGHT - 6 )) || scroll=()' \
    '        :'

run_case "textbox/never-scrolls" 1 \
    '        (( $(wc -l < "$view") > TUI_HEIGHT - 6 )) || scroll=()' \
    '        scroll=()'

run_case "textbox/unwrapped" 1 \
    '            wrap_to_width "$line" $(( TUI_WIDTH - 6 ))' \
    "            printf '%s\n' \"\$line\""

run_case "textbox/temp-left-behind" 1 \
    '    [[ -z "$view" ]] || rm -f "$view"' \
    '    :'
