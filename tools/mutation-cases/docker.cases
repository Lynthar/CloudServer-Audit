# Mutation cases: tests/test_fix_docker_daemon.bats against modules/docker.sh.
# mutate-suite: modules/docker.sh tests/test_fix_docker_daemon.bats
#
# What it pins: the running daemon's answer is final wherever it gives one
# (live-restore always, no-new-privileges from Engine 24, ICC through the default
# bridge), the configuration is read as systemd hands it to dockerd, live-restore
# is applied by reload and no-new-privileges by restart.
#
# Everything runs against the per-test fake /etc; `docker` and `systemctl` are
# stubs throughout, so no mutation here can reach a real daemon.

# ---- the audit predicate: the daemon's answer is final --------------------

# No "live-restore/false-falls-through" case here, deliberately: the line it would
# target is followed by a bare `return`, which returns the status of the last
# command, so both forms return exactly the same thing on both paths — an
# equivalent mutant no test can kill. The regression it was named for is covered
# by "daemon-not-asked-first" and by the bats test that pins a false-reporting
# daemon against a true daemon.json.

# Same defect from the other side: taking daemon.json first makes the
# daemon's answer irrelevant.
run_case "live-restore/daemon-not-asked-first" 1 \
    '    if live=$(_docker info --format '"'"'{{.LiveRestoreEnabled}}'"'"' 2>/dev/null); then' \
    '    if false; then'

# The fallback exists for an unreachable daemon only. Removing it makes a
# stopped daemon indistinguishable from an unconfigured host.
run_case "live-restore/no-fallback-when-unreachable" 1 \
    '        jq -e '"'"'.["live-restore"] == true'"'"' "$DOCKER_DAEMON_JSON" &>/dev/null' \
    '        return 1'

# The fallback reads the file only when there is one; inverting the gate makes
# a stopped daemon with a configured daemon.json report unconfigured.
# Occurrence 1 — the same line opens the writer's update branch further down.
run_case "live-restore/fallback-file-gate-inverted" 1 \
    '    if [[ -f "$DOCKER_DAEMON_JSON" ]]; then' \
    '    if [[ ! -f "$DOCKER_DAEMON_JSON" ]]; then'

# Case folding: `docker info` has printed capitalised booleans in the past,
# and the audit must not start reporting a configured host as unconfigured.
run_case "live-restore/case-sensitive-compare" 1 \
    '        [[ "${live,,}" == "true" ]]' \
    '        [[ "$live" == "true" ]]'

# ---- the fix's postcondition ---------------------------------------------

# The verify gate itself moved to execute_fix (FIX_VERIFY): its mutations are
# pinned by verify-engine.cases and verify-levels.cases, not here.

# ---- no-new-privileges and ICC: daemon first, then the configuration ------

# Engine 24+ reports the setting; skipping the question trusts a daemon.json
# the daemon never loaded.
run_case "nnp/daemon-not-asked" 1 \
    '    if (( major >= 24 )) && opts=$(_docker info --format '"'"'{{json .SecurityOptions}}'"'"' 2>/dev/null); then' \
    '    if false; then'

# An older daemon has no such field: asking it anyway reads "off" everywhere.
run_case "nnp/older-daemon-asked" 1 \
    '    if (( major >= 24 )) && opts=$(_docker info --format '"'"'{{json .SecurityOptions}}'"'"' 2>/dev/null); then' \
    '    if opts=$(_docker info --format '"'"'{{json .SecurityOptions}}'"'"' 2>/dev/null); then'

# The flag's value, not its presence: --no-new-privileges=false is off.
run_case "flag/presence-read-as-true" 1 \
    '            "--$1="*) val="${tok#*=}"; found=0 ;;' \
    '            "--$1="*) val=true; found=0 ;;'

# The command line outranks daemon.json.
run_case "configured/flag-ignored" 1 \
    '    if val=$(_docker_flag_value "$1"); then' \
    '    if false; then'

# Debian's docker.io passes DOCKER_OPTS through $DOCKER_OPTS in ExecStart.
run_case "argv/docker-opts-not-expanded" 1 \
    '        cmd="${cmd//'"'"'$DOCKER_OPTS'"'"'/$opts}"' \
    '        :'

# The file's value is quoted; unstripped, the last token is not the flag.
run_case "argv/quotes-kept" 1 \
    '        opts="${opts#[\"\'"'"']}"; opts="${opts%[\"\'"'"']}"' \
    '        :'

# The default bridge's enable_icc is the daemon's own answer.
run_case "icc/daemon-not-asked" 1 \
    '    if [[ "$icc" == "true" || "$icc" == "false" ]]; then' \
    '    if false; then'

# ---- the fix: reload, restart, refuse ---------------------------------------

# A flag already on the command line plus daemon.json stops dockerd starting.
run_case "fix/flag-on-cmdline-written-too" 1 \
    '    if _docker_flag_value "$setting" >/dev/null; then' \
    '    if false; then'

# Restarting for live-restore stops every container; a reload applies it.
run_case "fix/live-restore-restarts" 1 \
    '        if systemctl reload docker 2>/dev/null; then' \
    '        if systemctl restart docker 2>/dev/null; then'

# A failed reload reported as success.
run_case "fix/reload-failure-swallowed" 5 \
    '        return 1' \
    '        return 0'

# The restart prompt must say what a restart does on this host.
run_case "fix/restart-prompt-ignores-live-restore" 1 \
    '    _docker_check_live_restore && confirm_key="docker.confirm_restart_live"' \
    '    :'

# Declining must not restart anyway.
run_case "fix/declined-restart-restarts" 1 \
    '    if ! confirm_critical "$(i18n "$confirm_key")"; then' \
    '    if false; then'

# Declining is not success: the setting is written but not loaded.
run_case "fix/declined-restart-succeeds" 6 \
    '        return 1' \
    '        return 0'

# The answered "no" comes after daemon.json is written: a failure, not a skip.
run_case "fix/declined-restart-reads-as-skipped" 1 \
    '        _VPSSEC_DECLINED=0' \
    '        :'

# ---- the writer ----------------------------------------------------------

# Editing a file that is not valid JSON used to clobber it with jq's empty
# output.
run_case "writer/malformed-file-not-refused" 1 \
    '    if [[ -f "$DOCKER_DAEMON_JSON" ]] && ! jq empty "$DOCKER_DAEMON_JSON" 2>/dev/null; then' \
    '    if false; then'

# Merge, do not replace: the operator's other daemon settings have to survive.
run_case "writer/merge-becomes-replace" 1 \
    '        merged=$(jq --arg key "$setting" --argjson val "$value" '"'"'.[$key] = $val'"'"' \' \
    '        merged=$(jq -n --arg key "$setting" --argjson val "$value" '"'"'{($key): $val}'"'"' \'

# A merge that produced nothing must fail before the write: the appended newline
# would get it past write_file_atomic's empty-content refusal.
run_case "writer/empty-merge-written" 1 \
    '    if [[ -z "$merged" ]] || ! write_file_atomic "$DOCKER_DAEMON_JSON" "$merged"$'"'"'\n'"'"'; then' \
    '    if ! write_file_atomic "$DOCKER_DAEMON_JSON" "$merged"$'"'"'\n'"'"'; then'

# The shape the 0600 -> 0644 defect shipped in: a private temp file renamed
# over daemon.json, so the file takes the temp's mode and owner.
run_case "writer/own-temp-and-rename" 1 \
    '    if [[ -z "$merged" ]] || ! write_file_atomic "$DOCKER_DAEMON_JSON" "$merged"$'"'"'\n'"'"'; then' \
    '    if [[ -z "$merged" ]] || ! { printf "%s\\n" "$merged" > "$DOCKER_DAEMON_JSON.new" && mv "$DOCKER_DAEMON_JSON.new" "$DOCKER_DAEMON_JSON"; }; then'

# The pre-edit backup is what a rollback restores; without it the operator's
# original daemon.json is gone.
run_case "writer/existing-file-not-backed-up" 1 \
    '    backup_file "$DOCKER_DAEMON_JSON" >/dev/null || return 1' \
    '    :'

# A swallowed backup failure lets the fix rewrite /etc with no way back.
run_case "rollback/backup-failure-swallowed" 1 \
    '    backup_file "$DOCKER_DAEMON_JSON" >/dev/null || return 1' \
    '    backup_file "$DOCKER_DAEMON_JSON" >/dev/null 2>&1 || true'
