# Mutation cases: tests/test_secret_scan.bats against modules/cloud.sh.
# mutate-suite: modules/cloud.sh tests/test_secret_scan.bats

# An EC2-shaped IMDS no provider claims gets no user-data fetch, so no scan.
run_case "user-data/compatible-not-fetched" 1 \
    '        aws|aws-or-compatible)' \
    '        aws)'
