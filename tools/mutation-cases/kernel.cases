# Mutation cases: tests/test_fix_kernel.bats against modules/kernel.sh.
# mutate-suite: modules/kernel.sh tests/test_fix_kernel.bats
#
# The forwarding and RA exceptions live once, in _kernel_param_scan, which both the
# audits and the fixes read; the network/* cases below mutate that single copy.

run_case "ipv6/ra-guard-inverted" 1 \
    '    if _kernel_ipv6_uses_ra; then' \
    '    if ! _kernel_ipv6_uses_ra; then'

run_case "network/ra-guard-removed" 1 \
    '            if [[ "$host_uses_ra" == "yes" ]]; then' \
    '            if false; then'

run_case "ra-probe/failsafe-removed" 1 \
    '    routes=$(ip -6 route show default 2>/dev/null) || return 0' \
    '    routes=$(ip -6 route show default 2>/dev/null) || true'

run_case "coredump/dropin-needs-dir" 1 \
    '        mkdir -p "$KERNEL_COREDUMP_D"' \
    '        [[ -d "$KERNEL_COREDUMP_D" ]] || return 0'

run_case "coredump/always-reports-success" 1 \
    '    log_warn "kernel.disable_core_dump: still unrestricted after fix: $remaining"' \
    '    return 0'

run_case "coredump/limits-not-idempotent" 1 \
    '    if _kernel_core_unlimited; then' \
    '    if true; then'

# The fix writes on either path the audit flags, and its file is read last.
run_case "coredump/limits-fix-needs-limits-conf" 1 \
    '    [[ -f "$KERNEL_LIMITS_CONF" || -d "$KERNEL_LIMITS_D" ]] \' \
    '    [[ -f "$KERNEL_LIMITS_CONF" ]] \'

run_case "coredump/limits-dropin-read-first" 1 \
    'KERNEL_LIMITS_DROPIN="${KERNEL_LIMITS_D}/99-vpssec-core.conf"' \
    'KERNEL_LIMITS_DROPIN="${KERNEL_LIMITS_D}/00-vpssec-core.conf"'

run_case "dropin/header-filter-removed" 1 \
    '        existing=$(grep -vE '"'"'^[[:space:]]*(#|$)'"'"' "$VPSSEC_SYSCTL_CONF" 2>/dev/null \' \
    '        existing=$(cat "$VPSSEC_SYSCTL_CONF" 2>/dev/null \'

run_case "dropin/param-replace-removed" 1 \
    '                   | grep -vE "^${param_re}[[:space:]]*=" || true)' \
    '                   | cat || true)'

run_case "network/rp_filter-exception-gone" 1 \
    '           && _kernel_ip_forward_needed; then' \
    '           && false; then'

# Strict mode drops a forwarding host's asymmetric-return traffic; 0 goes to 2.
run_case "network/rp_filter-forwarding-target-strict" 1 \
    '            expected="2|1"' \
    '            :'

run_case "dropin/backup-skipped" 1 \
    '    backup_file "$VPSSEC_SYSCTL_CONF" >/dev/null || return 1' \
    '    :'

run_case "network/ip_forward-exception-gone" 1 \
    '        if [[ "$param" == "net.ipv4.ip_forward" ]] && _kernel_ip_forward_needed; then' \
    '        if false; then'

# A swallowed backup failure lets the fix rewrite /etc with no way back.
run_case "rollback/backup-failure-swallowed" 1 \
    '    backup_file "$VPSSEC_SYSCTL_CONF" >/dev/null || return 1' \
    '    backup_file "$VPSSEC_SYSCTL_CONF" >/dev/null 2>&1 || true'

# The second pass is what writes back a param the ip_forward write reset.
run_case "network/single-pass" 1 \
    '    for pass in 1 2; do' \
    '    for pass in 1; do'

# A higher value is stricter for >=N params; exact matching flags them and the fix lowers them.
run_case "threshold/minimum-read-as-exact" 1 \
    '            [[ "$actual" =~ ^-?[0-9]+$ ]] && (( actual >= ${exp#>=} )) && return 0' \
    '            [[ "$actual" == "${exp#>=}" ]] && return 0'

run_case "threshold/arithmetic-on-any-text" 1 \
    '            [[ "$actual" =~ ^-?[0-9]+$ ]] && (( actual >= ${exp#>=} )) && return 0' \
    '            (( actual >= ${exp#>=} )) && return 0'

run_case "threshold/fix-writes-the-operator" 1 \
    '    echo "${first#>=}"' \
    '    echo "$first"'

# Ubuntu's kernel blocks unprivileged perf only at 4; 3 there is mainline's 2.
run_case "perf/ubuntu-floor-lowered" 1 \
    '        echo 4' \
    '        echo 3'

# 1 locks the value until reboot, so a rollback could not undo it.
run_case "bpf/fix-writes-the-lock" 1 \
    '    "kernel.unprivileged_bpf_disabled:2|1:medium:Disable unprivileged BPF (exploit prevention)"' \
    '    "kernel.unprivileged_bpf_disabled:1|2:medium:Disable unprivileged BPF (exploit prevention)"'

# ---- IPv6 keys: only those that reach an interface, said honestly ----------

# A key that exists only under "all" reaches no interface; listing one again
# reads and writes a value nothing uses.
run_case "ipv6/all-only-key-listed" 1 \
    '    "net.ipv6.conf.default.accept_source_route:0:medium:IPv6 source routing (default)"' \
    '    "net.ipv6.conf.all.autoconf:0:low:IPv6 stateless autoconfiguration"'

# IPv6 has no send_redirects at all.
run_case "ipv6/nonexistent-key-listed" 1 \
    '    "net.ipv6.conf.all.accept_source_route:0:medium:IPv6 source routing"' \
    '    "net.ipv6.conf.all.send_redirects:0:medium:IPv6 ICMP redirects sending"'

run_case "ipv6/all-only-ra-key-written" 1 \
    '            "net.ipv6.conf.default.accept_ra=0"' \
    '            "net.ipv6.conf.all.accept_ra_defrtr=0"'

# The pass and the suggested fix must say existing interfaces are unchanged.
run_case "ipv6/secure-claims-every-interface" 1 \
    "                desc=\"\$(i18n 'kernel.ipv6_secure_desc')\"" \
    '                desc="IPv6 enabled and properly secured"'

run_case "ipv6/fix-suggestion-unqualified" 1 \
    "                suggestion=\"\$(i18n 'kernel.fix_ipv6')\" \\" \
    '                suggestion="Harden IPv6 parameters" \'

# ---- who forwards, one check per key, core-dump limits ---------------------

run_case "forwarding/interface-signal-removed" 1 \
    '            [[ -n "$(ip -br link show type "$type" 2>/dev/null)" ]] && return 0' \
    '            :'

run_case "forwarding/strongswan-unit-dropped" 1 \
    '    systemctl is-active --quiet strongswan-starter 2>/dev/null && return 0' \
    '    :'

# Listed twice, one weak value fails two scored checks.
run_case "dedup/suid_dumpable-back-in-table" 1 \
    '    "fs.protected_hardlinks:1:medium:Hardlink protection"' \
    '    "fs.suid_dumpable:0:medium:Disable SUID core dumps"'

run_case "dedup/ipv6-redirects-back-in-table" 1 \
    '    "net.ipv6.conf.all.accept_source_route:0:medium:IPv6 source routing"' \
    '    "net.ipv6.conf.default.accept_redirects:0:medium:IPv6 ICMP redirects (default)"'

# pam_limits reads limits.d after limits.conf, and the last entry wins.
run_case "coredump/limits-d-ignored" 1 \
    '        [[ -f "$f" ]] && files+=("$f")' \
    '        :'

run_case "coredump/first-entry-wins" 1 \
    "    awk '\$1 == \"*\" && (\$2 == \"hard\" || \$2 == \"-\") && \$3 == \"core\" { v = \$4 }" \
    "    awk '\$1 == \"*\" && (\$2 == \"hard\" || \$2 == \"-\") && \$3 == \"core\" && v == \"\" { v = \$4 }"

run_case "coredump/soft-limit-counted" 1 \
    "    awk '\$1 == \"*\" && (\$2 == \"hard\" || \$2 == \"-\") && \$3 == \"core\" { v = \$4 }" \
    "    awk '\$1 == \"*\" && \$3 == \"core\" { v = \$4 }"

# ---- containers: the host's kernel is not the container's to judge or fix --

run_case "container/kernel-params-scored" 1 \
    '    if [[ "$in_container" == true ]]; then' \
    '    if false; then'

run_case "container/kernel-params-pass-reported-failed" 1 \
    '        if (( total_issues == 0 )); then' \
    '        if false; then'

run_case "container/aslr-scored" 1 \
    '    if [[ "$aslr_status" != unknown ]] && detect_container >/dev/null; then' \
    '    if false; then'

# Unreadable is no state of the host's to report: it stays the unscored aslr_unknown.
run_case "container/aslr-unknown-called-host-state" 1 \
    '    if [[ "$aslr_status" != unknown ]] && detect_container >/dev/null; then' \
    '    if detect_container >/dev/null; then'

run_case "container/suid_dumpable-judged" 1 \
    '    if ! detect_container >/dev/null; then' \
    '    if true; then'

run_case "container/suid_dumpable-written" 2 \
    '    if ! detect_container >/dev/null; then' \
    '    if true; then'

# ---- runtime vs persist, no replay, undo ----------------------------------

run_case "runtime/refusal-uncounted-ipv6" 1 \
    '            1) ((runtime_failed++)) || true ;;' \
    '            1) : ;;'

run_case "runtime/refusal-called-persist" 2 \
    '            1) ((runtime_failed++)) || true ;;' \
    '            1) ((persist_failed++)) || true ;;'

run_case "replay/drop-in-reloaded" 1 \
    '    _kernel_write_sysctl "$1" "$2" || return 2' \
    '    _kernel_write_sysctl "$1" "$2" && sysctl -p "$VPSSEC_SYSCTL_CONF" >/dev/null 2>&1 || return 2'

# A value read after the ip_forward write is the reset one, not the original.
run_case "undo/network-reads-after-write" 1 \
    '                undo+=("$param=${before[$param]}")' \
    '                undo+=("$param=$(_kernel_get_sysctl "$param")")'

run_case "undo/aslr-not-recorded" 1 \
    '        record_undo kernel.enable_aslr "$(_kernel_undo_cmd "kernel.randomize_va_space=$old")"' \
    '        :'

# An unused IPv6 with weak settings: the desc goes back to repeating its title.
run_case "ipv6-desc/unused-names-no-setting" 1 \
    '                desc="$(i18n '"'"'kernel.ipv6_unused_insecure_desc'"'"' "ipv6_issues=${ipv6_text%; }")" \' \
    '                desc="$(i18n '"'"'kernel.ipv6_unused_insecure_desc'"'"')" \'
