# Mutation cases: tests/test_fix_ufw.bats against core/common.sh.
# mutate-suite: core/common.sh tests/test_fix_ufw.bats
#
# get_ssh_ports: an active ssh.socket's TCP listeners are the ports, whatever
# sshd -T says; otherwise `ListenAddress host:port` overrides Port, and only
# the listenaddress lines of sshd -T say so.

run_case "ports/listenaddress-ignored" 1 \
    "        ports=\$(awk '\$1 == \"listenaddress\" { n = split(\$2, a, \":\"); if (a[n] ~ /^[0-9]+\$/) print a[n] }' <<<\"\$dump\")" \
    '        ports=""'

run_case "ports/socket-ignored" 1 \
    '                systemctl show -p Listen --value "$unit" 2>/dev/null || true' \
    '                :'

run_case "ports/inactive-socket-trusted" 1 \
    '                systemctl is-active --quiet "$unit" 2>/dev/null || continue' \
    '                :'

run_case "ports/socket-unix-path-read" 1 \
    "            done | awk '\$2 == \"(Stream)\" && \$1 ~ /:[0-9]+\$/ { n = split(\$1, a, \":\"); print a[n] }')" \
    "            done | awk '\$2 == \"(Stream)\" { n = split(\$1, a, \":\"); print a[n] }')"
