# Everything here runs on Linux and must arrive LF. A CR breaks bash with
# `$'\r': command not found`, changes every hash in manifest.sha256, and in
# VERSION reaches the release workflow's tag-vs-VERSION check.
* text=auto eol=lf

# No binary files today; these pre-empt a text=auto misdetection, which
# would let eol=lf mangle an image.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.ico          binary
