#!/usr/bin/env bash
# vpssec - VPS security audit and hardening.
# Sub-commands: audit (read-only), guide (hardening wizard), rollback, status.
# Audit runs on Debian/Ubuntu/RHEL/Arch; guide and rollback are Debian only.

set -euo pipefail

# VPSSEC_ROOT is computed ONLY in core/common.sh, relative to its own path.
# Do not recompute it here — two definitions would drift.

# cron starts jobs with PATH=/usr/bin:/bin, where sysctl, sshd, ufw and nft are
# absent and every check would read "not installed". Append the sbin directories
# that are missing; the PATH given keeps its order, so its choices still win.
_vpssec_complete_path() {
    local dir
    for dir in /usr/local/sbin /usr/sbin /sbin; do
        [[ ":${PATH:-}:" == *":$dir:"* ]] || PATH="${PATH:+$PATH:}$dir"
    done
    export PATH
}
_vpssec_complete_path

# --- Source Core Modules ---

# readlink -f is load-bearing: install.sh symlinks /usr/local/bin/vpssec to this
# file, so BASH_SOURCE[0] is the link. Unresolved, every source below looks in
# /usr/local/bin/core/ and the installed command dies on the first one.
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/core/common.sh"
source "${VPSSEC_ROOT}/core/distro.sh"
source "${VPSSEC_ROOT}/core/state.sh"
source "${VPSSEC_ROOT}/core/report.sh"
source "${VPSSEC_ROOT}/core/ui_tui.sh"
source "${VPSSEC_ROOT}/core/ui_text.sh"
source "${VPSSEC_ROOT}/core/engine.sh"
source "${VPSSEC_ROOT}/core/help.sh"

# --- CLI Argument Parsing ---

show_help() {
    cat <<EOF
$(i18n 'cli.usage')

$(i18n 'cli.commands')
  $(i18n 'cli.cmd_audit')
  $(i18n 'cli.cmd_guide')
  $(i18n 'cli.cmd_rollback')
  $(i18n 'cli.cmd_status')
  $(i18n 'cli.cmd_help')

$(i18n 'cli.options')
  $(i18n 'cli.opt_lang')
  $(i18n 'cli.opt_no_color')
  $(i18n 'cli.opt_json_only')
  $(i18n 'cli.opt_yes')
  $(i18n 'cli.opt_strict')
  $(i18n 'cli.opt_debug')
  $(i18n 'cli.opt_include')
  $(i18n 'cli.opt_exclude')
  $(i18n 'cli.opt_fix')
  $(i18n 'cli.opt_help')
  $(i18n 'cli.opt_version')

$(i18n 'cli.examples')
  vpssec audit                     # $(i18n 'cli.ex_audit')
  vpssec audit --json-only         # $(i18n 'cli.ex_json')
  vpssec audit --include=ssh,ufw   # $(i18n 'cli.ex_include')
  vpssec guide                     # $(i18n 'cli.ex_guide')
  vpssec guide --fix=ssh.enable_pubkey --yes   # $(i18n 'cli.ex_fix')
  vpssec rollback                  # $(i18n 'cli.ex_rollback')

EOF
}

show_version() {
    echo "vpssec version ${VPSSEC_VERSION}"
}

# Parse the command line ONCE, in the current shell, returning the command
# through a global — a command substitution discards every VPSSEC_* set here.
# --help / --version / help are FLAGGED here, dispatched by main().
parse_args() {
    VPSSEC_HELP_REQUESTED=0
    VPSSEC_HELP_TOPIC=""
    VPSSEC_HELP_SUBCOMMAND=0
    VPSSEC_VERSION_REQUESTED=0
    VPSSEC_UNKNOWN_ARG=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            audit|guide|rollback|status)
                VPSSEC_MODE="$1"
                VPSSEC_MODE_SET=1
                export VPSSEC_MODE VPSSEC_MODE_SET
                # `rollback` takes an optional positional timestamp.
                # Consume it here so the loop doesn't reject it as an
                # unknown option.
                if [[ "$1" == "rollback" && $# -gt 1 && "$2" != -* ]]; then
                    VPSSEC_ROLLBACK_TIMESTAMP="$2"
                    export VPSSEC_ROLLBACK_TIMESTAMP
                    shift
                fi
                shift
                ;;
            help)
                VPSSEC_HELP_REQUESTED=1
                VPSSEC_HELP_SUBCOMMAND=1
                # Optional positional <module> topic, same lookahead.
                if [[ $# -gt 1 && "$2" != -* ]]; then
                    VPSSEC_HELP_TOPIC="$2"
                    shift
                fi
                shift
                ;;
            --lang=*)
                VPSSEC_LANG="${1#*=}"
                VPSSEC_LANG_SET=1
                export VPSSEC_LANG VPSSEC_LANG_SET
                shift
                ;;
            --no-color)
                # common.sh initialised the colour escapes at source time
                # from VPSSEC_COLOR + isatty, so they must be reset here,
                # before any menu renders.
                VPSSEC_COLOR=0
                RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' CYAN='' WHITE='' BOLD='' DIM='' NC=''
                SEV_HIGH='●' SEV_MEDIUM='●' SEV_LOW='●' SEV_SAFE='●'
                shift
                ;;
            --json-only)
                VPSSEC_JSON_ONLY=1
                export VPSSEC_JSON_ONLY
                shift
                ;;
            --yes|-y)
                VPSSEC_YES=1
                export VPSSEC_YES
                shift
                ;;
            --include=*)
                VPSSEC_INCLUDE="${1#*=}"
                export VPSSEC_INCLUDE
                shift
                ;;
            --exclude=*)
                VPSSEC_EXCLUDE="${1#*=}"
                export VPSSEC_EXCLUDE
                shift
                ;;
            --fix=*)
                # guide only: the fixes to apply, by id, instead of the menu.
                VPSSEC_FIX_IDS="${1#*=}"
                export VPSSEC_FIX_IDS
                shift
                ;;
            --debug)
                VPSSEC_DEBUG=1
                export VPSSEC_DEBUG
                shift
                ;;
            --strict)
                # Strict scoring: count the `optional`-category checks (weak
                # SSH algorithms, weak SGID, nginx DoS hardening, ...) toward
                # the score. Exported so state.sh's metrics pass sees it.
                VPSSEC_SECURITY_LEVEL=strict
                export VPSSEC_SECURITY_LEVEL
                shift
                ;;
            --help|-h)
                VPSSEC_HELP_REQUESTED=1
                shift
                ;;
            --version|-v)
                VPSSEC_VERSION_REQUESTED=1
                shift
                ;;
            *)
                # Reported by main once the whole line is read, so a --lang
                # after the mistyped word still applies.
                [[ -n "$VPSSEC_UNKNOWN_ARG" ]] || VPSSEC_UNKNOWN_ARG="$1"
                shift
                ;;
        esac
    done
}

# --- Main Entry Point ---

main() {
    # One pass over the command line; everything lands in globals.
    parse_args "$@"

    # Without jq no language file loads, so that message stays English.
    if [[ -n "$VPSSEC_UNKNOWN_ARG" ]]; then
        if check_command jq && i18n_load "${VPSSEC_LANG}" 2>/dev/null; then
            echo "$(i18n 'error.unknown_arg' "arg=$VPSSEC_UNKNOWN_ARG")" >&2
            echo "$(i18n 'error.see_help')" >&2
        else
            echo "Unknown command or option: $VPSSEC_UNKNOWN_ARG" >&2
            echo "Run 'vpssec --help' for usage" >&2
        fi
        exit 1
    fi

    # Terminal sub-commands, dispatched only after the WHOLE line has
    # been read so `vpssec help --lang=en_US` honours the language.
    # `--version` goes first because it needs no i18n.
    if (( VPSSEC_VERSION_REQUESTED )); then
        show_version
        exit 0
    fi

    # Every message is loaded through jq, so without it the first i18n_load
    # would end the run in silence. Fixed English: there are no translations.
    if ! check_command jq; then
        echo "vpssec: jq is required but not installed." >&2
        local jq_hint
        if jq_hint=$(pkg_install_hint jq); then
            echo "Install it with: $jq_hint" >&2
        fi
        exit 1
    fi

    if (( VPSSEC_HELP_REQUESTED )); then
        i18n_load "${VPSSEC_LANG}"
        if [[ -n "$VPSSEC_HELP_TOPIC" ]]; then
            vpssec_help_dispatch "$VPSSEC_HELP_TOPIC"
            exit $?
        fi
        # --help is the CLI option summary; `help` is the module/fix
        # overview. Disambiguated by which arg arrived.
        if (( VPSSEC_HELP_SUBCOMMAND )); then
            vpssec_help_dispatch ""
        else
            show_help
        fi
        exit 0
    fi

    # Fail fast on missing root before any menu. The second check below
    # covers the interactive path, where the command is known only after
    # select_mode.
    if [[ -n "${VPSSEC_MODE:-}" && "$VPSSEC_MODE" != "status" ]] && ! check_root; then
        i18n_load "${VPSSEC_LANG}" 2>/dev/null || true
        print_error "$(i18n 'error.root_required')"
        echo "$(i18n 'error.run_with_sudo' "cmd=$VPSSEC_MODE")" >&2
        exit 1
    fi

    # Show language selection if not specified
    select_language

    # Show mode selection if not specified (only for audit/guide, not rollback/status)
    select_mode

    # run.sh deletes its tree on exit, backups included: guide would change /etc
    # and lose its only undo. Checked on the settled mode, which a menu or
    # VPSSEC_MODE can set; exit 2 like run.sh's own refusal.
    if [[ -n "${VPSSEC_ONESHOT:-}" ]] \
       && [[ "${VPSSEC_MODE:-}" == "guide" || "${VPSSEC_MODE:-}" == "rollback" ]]; then
        i18n_load "${VPSSEC_LANG}" 2>/dev/null || true
        print_error "$(i18n 'error.oneshot_stateful' "cmd=$VPSSEC_MODE")"
        exit 2
    fi

    # Interactive path: the command is now known — enforce root before
    # we display the module menu so the user doesn't pick modules only
    # to be rejected.
    if [[ "${VPSSEC_MODE:-}" != "status" ]] && ! check_root; then
        i18n_load "${VPSSEC_LANG}" 2>/dev/null || true
        print_error "$(i18n 'error.root_required')"
        echo "$(i18n 'error.run_with_sudo' "cmd=${VPSSEC_MODE:-}")" >&2
        exit 1
    fi

    # Rejected before the module menu, so a RHEL/Arch user is not walked through
    # selection and then turned away. Exit 4 = capability not supported; 0 would
    # read as "hardening completed". guide_mode re-checks as defence in depth.
    if [[ "${VPSSEC_MODE:-}" == "guide" ]] && ! is_debian_based; then
        i18n_load "${VPSSEC_LANG}" 2>/dev/null || true
        print_warn "$(i18n 'guide.fix_debian_only')"
        exit 4
    fi

    # Show module selection if not specified via CLI
    select_modules

    # The command is whatever the CLI or the mode menu settled on.
    local command="${VPSSEC_MODE:-audit}"

    # Initialize vpssec
    vpssec_init

    # Defence in depth: re-check in case the command evolved after
    # parse_args (e.g. defaulted from VPSSEC_MODE). check_root is a
    # cheap syscall so the redundancy is fine.
    if [[ "$command" != "status" ]] && ! check_root; then
        print_error "$(i18n 'error.root_required')"
        echo "$(i18n 'error.run_with_sudo' "cmd=$command")" >&2
        exit 1
    fi

    # A bad VPSSEC_FS_TIMEOUT would skip every filesystem walk and report the
    # host clean, so the commands that audit refuse it up front.
    if [[ "$command" == "audit" || "$command" == "guide" ]] && ! fs_timeout_valid; then
        print_error "$(i18n 'error.bad_fs_timeout' "value=${VPSSEC_FS_TIMEOUT:-}")"
        exit 1
    fi

    # Check OS support
    if ! is_supported_os; then
        local os=$(detect_os)
        local version=$(detect_os_version)
        # What the question below is about, so it reaches the terminal too.
        tty_warn "$(i18n 'error.unsupported_os' "os=${os} ${version}")"
        tty_say "$(i18n 'error.supported_platforms')"
        tty_say ""

        if [[ "$command" != "status" ]] && ! confirm "$(i18n 'common.continue_anyway')" "n"; then
            exit 1
        fi
    fi

    # Check required dependencies
    local missing_deps=$(check_required_deps 2>&1) || true
    if [[ -n "$missing_deps" ]]; then
        print_error "$(i18n 'preflight.dep_missing' "dep=$missing_deps")"
        # This abort is the first thing a RHEL or Arch operator sees, and it
        # used to tell them to run apt. check_required_deps reports command
        # names, which are not package names on any distribution.
        local dep_pkgs dep_hint
        # shellcheck disable=SC2086  # deliberate split: one command per word
        dep_pkgs=$(distro_packages_for_commands $missing_deps)
        # shellcheck disable=SC2086  # deliberate split: one package per word
        if dep_hint=$(pkg_install_hint $dep_pkgs); then
            echo "$(i18n 'preflight.install_with' "cmd=$dep_hint")" >&2
        else
            echo "$(i18n 'preflight.install_deps' "deps=$dep_pkgs")" >&2
        fi
        exit 1
    fi

    # Detect TUI backend
    tui_detect_backend || true

    # Load modules
    module_load_all "${VPSSEC_INCLUDE:-}" "${VPSSEC_EXCLUDE:-}"

    # Execute command
    case "$command" in
        audit)
            print_header "$(i18n 'cli.header_title')"
            print_msg "$(i18n 'status.version' "version=${VPSSEC_VERSION}")"
            print_msg "$(i18n 'report.host_date'): $(date '+%Y-%m-%d %H:%M:%S')"
            print_msg "$(i18n 'report.host_os'): $(detect_os) $(detect_os_version)"
            # The modules that will run: context modules added, excludes removed.
            if score_is_partial; then
                print_msg "$(i18n 'report.host_modules'): $(_report_modules_scope)"
            fi
            audit_all
            ;;
        guide)
            guide_mode
            ;;
        rollback)
            rollback_mode "${VPSSEC_ROLLBACK_TIMESTAMP:-}"
            ;;
        status)
            status_mode
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
