# Plant: a /etc/passwd line reusing an existing regular user's UID (AUTH-9208).
#
# Safety: the phantom account gets /usr/sbin/nologin and a non-existent home, so
# even a failed restore cannot log in. It still writes /etc/passwd — disposable
# host only.
# Severity: medium, deliberately. A duplicate UID 0 is the backdoor pattern and is
# reported separately at high by users.uid0_found; a duplicate among regular UIDs
# is ambiguous ownership, which the project's rubric rates medium.
TEST_DESC="Two /etc/passwd entries with the same UID trigger users.duplicate_uids"
EXPECT_ID="users.duplicate_uids"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="medium"
MODULE="users"

_BACKUP="/etc/passwd.vpssec-mutation-bak"

precheck() {
    # Need a regular (non-root, non-nobody) UID to alias.
    awk -F: '$3 >= 1000 && $3 < 65000 {found=1; exit} END {exit !found}' /etc/passwd
}

mutate() {
    local target_uid
    target_uid=$(awk -F: '$3 >= 1000 && $3 < 65000 {print $3; exit}' /etc/passwd)
    [[ -z "$target_uid" ]] && return 1
    cp /etc/passwd "$_BACKUP" || return 1
    printf 'vpssecdup:x:%s:65534:vpssec mutation test:/nonexistent:/usr/sbin/nologin\n' \
        "$target_uid" >> /etc/passwd
    return 0
}

restore() {
    [[ -f "$_BACKUP" ]] && mv "$_BACKUP" /etc/passwd
    return 0
}
