# Plant: nothing — the case applies where logrotate is absent (the mutation
# host image ships without it).
# Expect: logging.logrotate_not_configured → logging.setup_logrotate → logrotate_ok.
# The fix installs a package, which rollback does not track: the backup session
# holds no file, `vpssec rollback` reports nothing restored (rc 1), and the
# audit stays green. That boundary is the assertion, not a tolerated failure.
TEST_DESC="logrotate absent: logging.setup_logrotate converges; a package install is outside rollback"
EXPECT_ID="logging.logrotate_not_configured"
EXPECT_STATUS="failed"
MODULE="logging"
FIX_ID="logging.setup_logrotate"
EXPECT_FIXED_ID="logging.logrotate_ok"
EXPECT_FIXED_STATUS="passed"
EXPECT_ROLLBACK_ID="logging.logrotate_ok"
EXPECT_ROLLBACK_STATUS="passed"
EXPECT_ROLLBACK_RC=1

precheck() {
    ! command -v logrotate >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    return 0
}

restore() {
    DEBIAN_FRONTEND=noninteractive apt-get remove --purge -y -qq logrotate >/dev/null 2>&1
    return 0
}
