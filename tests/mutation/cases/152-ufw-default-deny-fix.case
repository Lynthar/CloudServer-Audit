# Plant: ufw enabled with SSH allowed and the incoming policy set to allow.
# Expect: ufw.default_accept → ufw.set_default_deny → ufw.default_deny. RISKY with
# no prompt of its own, so the engine asks on the terminal (FIX_TTY_ANSWERS).
# ufw keeps the policy in /etc/default/ufw, which the fix does not back up, so
# rollback restores nothing (rc 1) and the policy stays deny.
TEST_DESC="ufw default incoming allow: ufw.set_default_deny converges through the engine's prompt; rollback leaves it"
EXPECT_ID="ufw.default_accept"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="medium"
MODULE="ufw"
FIX_ID="ufw.set_default_deny"
FIX_TTY_ANSWERS="yes"
EXPECT_FIXED_ID="ufw.default_deny"
EXPECT_FIXED_STATUS="passed"
EXPECT_ROLLBACK_ID="ufw.default_deny"
EXPECT_ROLLBACK_STATUS="passed"
EXPECT_ROLLBACK_RC=1

_NFT_WAS_EMPTY=0

precheck() {
    ! command -v ufw >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    if ! command -v nft >/dev/null 2>&1 || [[ -z "$(nft list ruleset 2>/dev/null)" ]]; then
        _NFT_WAS_EMPTY=1
    fi
    DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw >/dev/null 2>&1 || return 1
    ufw allow 22/tcp >/dev/null 2>&1
    ufw default allow incoming >/dev/null 2>&1
    ufw --force enable >/dev/null 2>&1
}

restore() {
    ufw --force disable >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get remove --purge -y -qq ufw >/dev/null 2>&1
    # ufw disable leaves its chains behind; later cases must not inherit them.
    (( _NFT_WAS_EMPTY == 1 )) && command -v nft >/dev/null 2>&1 && nft flush ruleset >/dev/null 2>&1
    return 0
}
