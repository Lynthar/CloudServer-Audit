# Plant: make /boot/grub/grub.cfg world-writable (666). Read access is not the
# risk — the module expects 644 — writing the kernel command line is.
# Expect: grub.cfg is not a credential file, but a group or world write bit on any
# sensitive file routes it into the HIGH bucket, so it surfaces as
# sensitive_perms_wrong at high, not as the low _minor finding.
TEST_DESC="/boot/grub/grub.cfg with 666 perms surfaces in sensitive_perms_wrong at high"
EXPECT_ID="filesystem.sensitive_perms_wrong"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="high"
# Critical for this case: the host may already have other wrong-perm files
# queued, so an EXPECT_ID match alone proves nothing. Force the substring check.
EXPECT_DESC_CONTAINS="/boot/grub/grub.cfg"
MODULE="filesystem"

_TARGET="/boot/grub/grub.cfg"
_ORIG_PERMS=""
_PLANTED=""   # what mutate created, removed again by restore

# A host without GRUB (the container) gets a stand-in file: the check reads
# only its mode, so an empty one is the same plant.
mutate() {
    if [[ ! -e "$_TARGET" ]]; then
        [[ -d /boot/grub ]] || { mkdir -p /boot/grub || return 1; _PLANTED="/boot/grub"; }
        install -m 600 /dev/null "$_TARGET" || return 1
        _PLANTED="${_PLANTED:-$_TARGET}"
    fi
    _ORIG_PERMS=$(stat -c '%a' "$_TARGET" 2>/dev/null)
    chmod 666 "$_TARGET"
    return 0
}

restore() {
    if [[ -n "$_PLANTED" ]]; then
        rm -rf "$_PLANTED"
    else
        chmod "${_ORIG_PERMS:-600}" "$_TARGET"
    fi
    return 0
}
