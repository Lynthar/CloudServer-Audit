# Plant: nothing — the case applies where fail2ban is absent (the mutation host
# image ships without it).
# Expect: fail2ban.not_installed → fail2ban.install → fail2ban.service_active:
# the fix installs, enables and starts the service and writes the sshd jail
# drop-in, so the post-fix audit must see a RUNNING fail2ban, not just a package.
# Rollback deletes the drop-in it created (rc 0) but cannot uninstall or stop
# anything, so the service stays active: the drop-in is what tells a done
# rollback from one that changed nothing.
# This image has no rsyslog, so no /var/log/auth.log for the stock sshd jail:
# without the drop-in the config fails `fail2ban-client -t`, and the rollback
# transcript ($STAGE_LOG) must say fail2ban will not start, not "restart it".
TEST_DESC="fail2ban absent: fail2ban.install converges to a running service; rollback only removes its drop-in"
EXPECT_ID="fail2ban.not_installed"
EXPECT_STATUS="failed"
MODULE="fail2ban"
FIX_ID="fail2ban.install"
EXPECT_FIXED_ID="fail2ban.service_active"
EXPECT_FIXED_STATUS="passed"
EXPECT_ROLLBACK_ID="fail2ban.service_active"
EXPECT_ROLLBACK_STATUS="passed"
EXPECT_ROLLBACK_RC=0

_DROPIN="/etc/fail2ban/jail.d/99-vpssec-sshd.local"

precheck() {
    ! command -v fail2ban-client >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    host_snapshot /etc/fail2ban /var/lib/fail2ban /run/fail2ban /var/log/fail2ban.log
}

postfix() {
    [[ -e "$_DROPIN" ]] || { echo "         the fix wrote no $_DROPIN"; return 1; }
}

postrollback() {
    [[ ! -e "$_DROPIN" ]] || { echo "         rollback left $_DROPIN"; return 1; }
    ! fail2ban-client -t >/dev/null 2>&1 \
        || { echo "         the restored config passes -t: is rsyslog in the image now?"; return 1; }
    grep -qF "fails 'fail2ban-client -t'" "$STAGE_LOG" \
        || { echo "         rollback did not say fail2ban cannot start again"; return 1; }
}

restore() {
    rm -f "$_DROPIN"
    host_restore fail2ban.service
}
