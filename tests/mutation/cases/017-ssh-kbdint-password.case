# Plant: PasswordAuthentication no, but KbdInteractiveAuthentication yes with the
# host's UsePAM yes — PAM asks pam_unix for the same password over that path.
# Expect: ssh.password_auth_enabled at HIGH, where ssh.password_auth_disabled
# used to pass; no fix is attached (the fix writes PasswordAuthentication only).
TEST_DESC="Password over keyboard-interactive (PAM) is a password login"
EXPECT_ID="ssh.password_auth_enabled"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="high"
EXPECT_DESC_CONTAINS="keyboard-interactive"
MODULE="ssh"

_DROPIN="/etc/ssh/sshd_config.d/01-vpssec-mutation-test.conf"
_SERVICE=""
_pick_service() {
    if systemctl list-unit-files ssh.service &>/dev/null; then _SERVICE="ssh"
    elif systemctl list-unit-files sshd.service &>/dev/null; then _SERVICE="sshd"
    fi
}

# grep reads to the end (no -q): under the runner's pipefail an early exit
# would SIGPIPE sshd and read as "not applicable".
precheck() {
    command -v sshd >/dev/null 2>&1 && [[ -d /etc/ssh/sshd_config.d ]] &&
        sshd -T 2>/dev/null | grep -x 'usepam yes' >/dev/null
}

mutate() {
    _pick_service
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication yes\n' > "$_DROPIN"
    chmod 644 "$_DROPIN"
    sshd -t >/dev/null 2>&1 || { rm -f "$_DROPIN"; return 1; }
    [[ -n "$_SERVICE" ]] && systemctl reload "$_SERVICE" >/dev/null 2>&1
    return 0
}

restore() {
    rm -f "$_DROPIN"
    [[ -n "$_SERVICE" ]] && systemctl reload "$_SERVICE" >/dev/null 2>&1
    return 0
}
