# Plant: fail2ban installed and running, with a jail.local disabling the sshd jail
# (TOOL-5104). On a stock Debian install sshd is the only enabled jail, so this
# leaves the service running with zero active jails — the silent no-op state
# fail2ban.no_jails_active exists to catch.
# The image leaves fail2ban out (the 17x cases start from absent), so the case
# installs it and restore undoes it all through the runner's host_restore. An
# empty auth.log gives the stock sshd jail a file to poll: the image runs no
# syslog, and without one the stock config cannot start at all (as 171 / 172).
# Severity: low, deliberately, and consistent with fail2ban.service_inactive.
# fail2ban is a rate-limiting convenience on top of SSH auth, not the control that
# keeps an attacker out; the high-severity findings for that (password auth
# enabled, root login permitted) live in the ssh module.
TEST_DESC="jail.local disabling sshd triggers fail2ban.no_jails_active"
EXPECT_ID="fail2ban.no_jails_active"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="low"
MODULE="fail2ban"

_JAIL_LOCAL="/etc/fail2ban/jail.local"
_AUTHLOG="/var/log/auth.log"
# Number of jails fail2ban reports running, empty while it does not answer.
_jail_count() {
    fail2ban-client status 2>/dev/null | sed -n 's/.*Number of jail:[[:space:]]*//p'
}

precheck() {
    ! command -v fail2ban-client >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    local i
    host_snapshot /etc/fail2ban /var/lib/fail2ban /run/fail2ban /var/log/fail2ban.log "$_AUTHLOG"
    touch "$_AUTHLOG"
    DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fail2ban >/dev/null 2>&1
    # The runner does not restore after a failed mutate: undo the install here.
    command -v fail2ban-client >/dev/null 2>&1 || { restore; return 1; }
    systemctl enable --now fail2ban >/dev/null 2>&1
    for i in $(seq 1 40); do [[ "$(_jail_count)" == 1 ]] && break; sleep 0.25; done
    [[ "$(_jail_count)" == 1 ]] || { restore; return 1; }

    printf '[sshd]\nenabled = false\n' > "$_JAIL_LOCAL"
    systemctl reload fail2ban >/dev/null 2>&1 || systemctl restart fail2ban >/dev/null 2>&1
    for i in $(seq 1 40); do [[ "$(_jail_count)" == 0 ]] && break; sleep 0.25; done
    [[ "$(_jail_count)" == 0 ]] && systemctl is-active --quiet fail2ban && return 0
    restore
    return 1
}

restore() {
    rm -f "$_JAIL_LOCAL"
    host_restore fail2ban.service
}
