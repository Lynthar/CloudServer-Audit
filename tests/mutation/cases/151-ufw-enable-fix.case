# Plant: ufw installed and left inactive, as a fresh install is.
# Expect: ufw.disabled → ufw.enable → ufw.enabled. The fix allows every sshd port,
# shows the rules and asks on the terminal before enabling (FIX_TTY_ANSWERS).
# ufw's rule files change through ufw; restoring them under a live firewall
# could cut the session, so no file is backed up and the logged undo command
# (ufw disable, delete the added rules) is what takes the host back.
TEST_DESC="ufw inactive: ufw.enable converges through its terminal prompt; its logged undo command reverts it"
EXPECT_ID="ufw.disabled"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="medium"
MODULE="ufw"
FIX_ID="ufw.enable"
FIX_TTY_ANSWERS="yes"
EXPECT_FIXED_ID="ufw.enabled"
EXPECT_FIXED_STATUS="passed"
ROLLBACK_BY="undo"
EXPECT_ROLLBACK_ID="ufw.disabled"
EXPECT_ROLLBACK_STATUS="failed"
EXPECT_ROLLBACK_RC=0

precheck() {
    ! command -v ufw >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    host_snapshot /etc/ufw /etc/default/ufw /var/lib/ufw
    DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw >/dev/null 2>&1 || return 1
    ufw --force disable >/dev/null 2>&1
    return 0
}

restore() {
    ufw --force disable >/dev/null 2>&1
    host_restore ufw.service
}
