# Plant: fail2ban installed, then stopped and disabled. An empty auth.log gives the
# stock sshd jail a file to poll: this image runs no syslog, and without one the
# stock config cannot start at all.
# Expect: fail2ban.service_inactive → fail2ban.enable_service → fail2ban.service_active.
# The fix enables and starts the unit and writes no file, so it leaves no session;
# the logged undo command (systemctl disable --now) stops it again.
TEST_DESC="fail2ban stopped and disabled: fail2ban.enable_service converges; its logged undo command reverts it"
EXPECT_ID="fail2ban.service_inactive"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="low"
MODULE="fail2ban"
FIX_ID="fail2ban.enable_service"
EXPECT_FIXED_ID="fail2ban.service_active"
EXPECT_FIXED_STATUS="passed"
ROLLBACK_BY="undo"
EXPECT_ROLLBACK_ID="fail2ban.service_inactive"
EXPECT_ROLLBACK_STATUS="failed"
EXPECT_ROLLBACK_RC=0

_AUTHLOG="/var/log/auth.log"

precheck() {
    ! command -v fail2ban-client >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1
}

mutate() {
    host_snapshot /etc/fail2ban /var/lib/fail2ban /run/fail2ban /var/log/fail2ban.log "$_AUTHLOG"
    touch "$_AUTHLOG"
    DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq fail2ban >/dev/null 2>&1 || return 1
    systemctl disable --now fail2ban >/dev/null 2>&1
    return 0
}

restore() {
    rm -f /etc/fail2ban/jail.d/99-vpssec-sshd.local
    host_restore fail2ban.service
}
