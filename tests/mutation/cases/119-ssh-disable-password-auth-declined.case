# Plant: as 116 — PasswordAuthentication yes in a 99- drop-in, plus an admin the
# fix's safety gate accepts (sudo member, login shell, authorized key, NOPASSWD).
# Expect: ssh.password_auth_enabled; the fix opens its rescue sshd and asks on the
# terminal, and the answer is no (FIX_TTY_ANSWERS). A declined fix is a skip: guide
# exits 0, no 00- drop-in, no session (EXPECT_DECLINED). postfix() asserts the rescue
# is gone again: sshd listens where it did before and its temp files are deleted.
TEST_DESC="PasswordAuthentication=yes: answering no at ssh.disable_password_auth's prompt changes nothing and closes the rescue"
EXPECT_ID="ssh.password_auth_enabled"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="high"
MODULE="ssh"
FIX_ID="ssh.disable_password_auth"
FIX_TTY_ANSWERS="no"
EXPECT_DECLINED=1
EXPECT_FIXED_ID="ssh.password_auth_enabled"
EXPECT_FIXED_STATUS="failed"

_DROPIN="/etc/ssh/sshd_config.d/99-vpssec-mutation-test.conf"
_HARDENING="/etc/ssh/sshd_config.d/00-vpssec-hardening.conf"
_ADMIN="vpssecadm"
_KEYDIR=""
_SUDOERS="/etc/sudoers.d/90-vpssec-mutation-test"
_LISTENERS=""
_SERVICE=""
_pick_service() {
    if systemctl list-unit-files ssh.service &>/dev/null; then _SERVICE="ssh"
    elif systemctl list-unit-files sshd.service &>/dev/null; then _SERVICE="sshd"
    fi
}

_listeners() { ss -tlnH 2>/dev/null | awk '{print $4}' | sort; }

precheck() {
    command -v sshd >/dev/null 2>&1 && command -v ssh-keygen >/dev/null 2>&1 \
        && [[ -d /etc/ssh/sshd_config.d ]] && getent group sudo >/dev/null \
        && ! getent passwd "$_ADMIN" >/dev/null && [[ ! -e "$_HARDENING" ]] \
        && [[ -r /etc/sudoers && -d /etc/sudoers.d ]]
}

mutate() {
    _pick_service
    [[ -n "$_SERVICE" ]] || return 1
    _KEYDIR=$(mktemp -d) || return 1
    useradd -m -s /bin/bash -G sudo "$_ADMIN" || return 1
    ssh-keygen -q -t ed25519 -N '' -f "$_KEYDIR/key" || return 1
    install -d -m 700 -o "$_ADMIN" -g "$_ADMIN" "/home/$_ADMIN/.ssh"
    install -m 600 -o "$_ADMIN" -g "$_ADMIN" "$_KEYDIR/key.pub" "/home/$_ADMIN/.ssh/authorized_keys"
    printf '%s ALL=(ALL) NOPASSWD:ALL\n' "$_ADMIN" > "$_SUDOERS"
    chmod 440 "$_SUDOERS"
    printf 'PasswordAuthentication yes\n' > "$_DROPIN"
    chmod 644 "$_DROPIN"
    systemctl reload "$_SERVICE" >/dev/null 2>&1 || return 1
    # sshd re-executes on reload: wait until it listens again before the snapshot.
    local i
    for i in $(seq 1 50); do
        _listeners | grep -qE ':22$' && break
        sleep 0.1
    done
    _LISTENERS=$(_listeners)
    return 0
}

postfix() {
    [[ ! -e "$_HARDENING" ]] || { echo "         the declined fix wrote $_HARDENING"; return 1; }
    [[ "$(_listeners)" == "$_LISTENERS" ]] \
        || { echo "         listening sockets differ from before (rescue left up, or sshd taken down)"; _listeners | sed 's/^/         | /'; return 1; }
    ! compgen -G "${TMPDIR:-/tmp}/vpssec-sshd-rescue*" >/dev/null \
        || { echo "         rescue temp files left behind"; return 1; }
}

restore() {
    rm -f "$_DROPIN" "$_SUDOERS" "$_HARDENING"
    [[ -n "$_KEYDIR" ]] && rm -rf "$_KEYDIR"
    userdel -r "$_ADMIN" >/dev/null 2>&1
    systemctl reload "$_SERVICE" >/dev/null 2>&1
    return 0
}
