# Plant: nothing — the image ships without unattended-upgrades and with an empty
# apt cache, so the fix must refresh the index before it can install.
# Expect: update.unattended_not_installed → update.install_unattended →
# update.unattended_enabled. 20auto-upgrades is recorded before the install (its
# postinst writes it), so rollback deletes it and the origins drop-in (rc 0): the
# package stays, its removal logged as the undo command, and the host is off again.
TEST_DESC="unattended-upgrades absent: update.install_unattended converges; rollback switches it off again"
EXPECT_ID="update.unattended_not_installed"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="low"
MODULE="update"
FIX_ID="update.install_unattended"
EXPECT_FIXED_ID="update.unattended_enabled"
EXPECT_FIXED_STATUS="passed"
EXPECT_ROLLBACK_ID="update.unattended_disabled"
EXPECT_ROLLBACK_STATUS="failed"
EXPECT_ROLLBACK_RC=0

precheck() {
    ! dpkg -l unattended-upgrades 2>/dev/null | grep -q '^ii' && command -v apt-get >/dev/null 2>&1
}

mutate() {
    host_snapshot /etc/apt/apt.conf.d/20auto-upgrades /etc/apt/apt.conf.d/50unattended-upgrades \
        /etc/apt/apt.conf.d/52vpssec-unattended-security /var/lib/unattended-upgrades \
        /var/log/unattended-upgrades
}

restore() {
    rm -f /etc/apt/apt.conf.d/20auto-upgrades /etc/apt/apt.conf.d/52vpssec-unattended-security
    host_restore unattended-upgrades.service
}
