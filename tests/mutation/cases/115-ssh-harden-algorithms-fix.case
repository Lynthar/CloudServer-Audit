# Plant: a 99- drop-in offering 3des-cbc. sshd keeps the FIRST value it reads and
# the fix writes 00-vpssec-hardening.conf, so the fix wins only while its file exists.
# Expect: ssh.weak_algorithms naming cipher:3des-cbc → ssh.harden_algorithms →
# ssh.algorithms_ok; rollback deletes the fix's drop-in, the plant rules again and
# the same cipher is reported (rc 0).
TEST_DESC="3des-cbc offered: ssh.harden_algorithms converges, rollback re-exposes it"
EXPECT_ID="ssh.weak_algorithms"
EXPECT_STATUS="failed"
EXPECT_SEVERITY="low"
EXPECT_DESC_CONTAINS="cipher:3des-cbc"
MODULE="ssh"
FIX_ID="ssh.harden_algorithms"
EXPECT_FIXED_ID="ssh.algorithms_ok"
EXPECT_FIXED_STATUS="passed"
EXPECT_ROLLBACK_ID="ssh.weak_algorithms"
EXPECT_ROLLBACK_STATUS="failed"
EXPECT_ROLLBACK_RC=0

_DROPIN="/etc/ssh/sshd_config.d/99-vpssec-mutation-test.conf"
_HARDENING="/etc/ssh/sshd_config.d/00-vpssec-hardening.conf"
_HAD_HARDENING=0
_SERVICE=""
_pick_service() {
    if systemctl list-unit-files ssh.service &>/dev/null; then _SERVICE="ssh"
    elif systemctl list-unit-files sshd.service &>/dev/null; then _SERVICE="sshd"
    fi
}

precheck() {
    command -v sshd >/dev/null 2>&1 && [[ -d /etc/ssh/sshd_config.d ]]
}

mutate() {
    _pick_service
    [[ -f "$_HARDENING" ]] && _HAD_HARDENING=1
    printf 'Ciphers aes128-ctr,3des-cbc\n' > "$_DROPIN"
    chmod 644 "$_DROPIN"
    sshd -t >/dev/null 2>&1 || { rm -f "$_DROPIN"; return 1; }
    [[ -n "$_SERVICE" ]] && systemctl reload "$_SERVICE" >/dev/null 2>&1
    return 0
}

restore() {
    rm -f "$_DROPIN"
    (( _HAD_HARDENING == 0 )) && rm -f "$_HARDENING"
    [[ -n "$_SERVICE" ]] && systemctl reload "$_SERVICE" >/dev/null 2>&1
    return 0
}
